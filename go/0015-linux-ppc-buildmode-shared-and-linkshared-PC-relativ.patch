index 490b545ee0..87b108b05c 100644
--- a/src/internal/platform/supported.go
+++ b/src/internal/platform/supported.go
@@ -194,7 +194,7 @@ func BuildModeSupported(compiler, buildmode, goos, goarch string) bool {
 
 	case "shared":
 		switch platform {
-		case "linux/386", "linux/amd64", "linux/arm", "linux/arm64", "linux/ppc64", "linux/ppc64le", "linux/s390x":
+		case "linux/386", "linux/amd64", "linux/arm", "linux/arm64", "linux/ppc", "linux/ppc64", "linux/ppc64le", "linux/s390x":
 			return true
 		}
 		return false
