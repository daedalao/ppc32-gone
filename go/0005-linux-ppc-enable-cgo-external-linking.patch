diff --git a/src/runtime/cgo/asm_ppc.s b/src/runtime/cgo/asm_ppc.s
new file mode 100644
index 0000000000..280867987b
--- /dev/null
+++ b/src/runtime/cgo/asm_ppc.s
@@ -0,0 +1,123 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build ppc
+
+#include "textflag.h"
+
+#define FIXED_FRAME 8
+
+// Set the x_crosscall2_ptr C function pointer variable point to crosscall2.
+// It's such a pointer chain: _crosscall2_ptr -> x_crosscall2_ptr -> crosscall2
+TEXT ·set_crosscall2(SB),NOSPLIT,$0-0
+	MOVW	_crosscall2_ptr(SB), R5
+	MOVW	$crosscall2_trampoline<>(SB), R6
+	MOVW	R6, (R5)
+	RET
+
+TEXT crosscall2_trampoline<>(SB),NOSPLIT,$0-0
+	JMP	crosscall2(SB)
+
+// Called by C code generated by cmd/cgo.
+// func crosscall2(fn, a unsafe.Pointer, n int32, ctxt uintptr)
+// Saves C callee-saved registers and calls cgocallback with three arguments.
+// fn is the PC of a func(a unsafe.Pointer) function.
+//
+// SysV ABI: R3 = fn, R4 = a, R5 = n, R6 = ctxt.
+// Frame layout (240 bytes): 0 back chain, 4 LR save slot (unused),
+// 8..19 Go call arguments, 20..91 R14-R31, 96..239 F14-F31.
+TEXT crosscall2(SB),NOSPLIT|NOFRAME,$0
+	MOVWU	R1, -240(R1)
+	MOVW	R14, 20(R1)
+	MOVW	R15, 24(R1)
+	MOVW	R16, 28(R1)
+	MOVW	R17, 32(R1)
+	MOVW	R18, 36(R1)
+	MOVW	R19, 40(R1)
+	MOVW	R20, 44(R1)
+	MOVW	R21, 48(R1)
+	MOVW	R22, 52(R1)
+	MOVW	R23, 56(R1)
+	MOVW	R24, 60(R1)
+	MOVW	R25, 64(R1)
+	MOVW	R26, 68(R1)
+	MOVW	R27, 72(R1)
+	MOVW	R28, 76(R1)
+	MOVW	R29, 80(R1)
+	MOVW	g, 84(R1)
+	MOVW	R31, 88(R1)
+	MOVW	LR, R31
+	MOVW	R31, 244(R1)	// LR save slot in the caller's frame
+	FMOVD	F14, 96(R1)
+	FMOVD	F15, 104(R1)
+	FMOVD	F16, 112(R1)
+	FMOVD	F17, 120(R1)
+	FMOVD	F18, 128(R1)
+	FMOVD	F19, 136(R1)
+	FMOVD	F20, 144(R1)
+	FMOVD	F21, 152(R1)
+	FMOVD	F22, 160(R1)
+	FMOVD	F23, 168(R1)
+	FMOVD	F24, 176(R1)
+	FMOVD	F25, 184(R1)
+	FMOVD	F26, 192(R1)
+	FMOVD	F27, 200(R1)
+	FMOVD	F28, 208(R1)
+	FMOVD	F29, 216(R1)
+	FMOVD	F30, 224(R1)
+	FMOVD	F31, 232(R1)
+
+	// Set up Go ABI constant registers
+	XOR	R0, R0
+
+	// Load the current g.
+	BL	runtime·load_g(SB)
+
+	MOVW	R3, FIXED_FRAME+0(R1)	// fn unsafe.Pointer
+	MOVW	R4, FIXED_FRAME+4(R1)	// a unsafe.Pointer
+	// Skip R5 = n uint32
+	MOVW	R6, FIXED_FRAME+8(R1)	// ctxt uintptr
+
+	BL	runtime·cgocallback(SB)
+
+	MOVW	20(R1), R14
+	MOVW	24(R1), R15
+	MOVW	28(R1), R16
+	MOVW	32(R1), R17
+	MOVW	36(R1), R18
+	MOVW	40(R1), R19
+	MOVW	44(R1), R20
+	MOVW	48(R1), R21
+	MOVW	52(R1), R22
+	MOVW	56(R1), R23
+	MOVW	60(R1), R24
+	MOVW	64(R1), R25
+	MOVW	68(R1), R26
+	MOVW	72(R1), R27
+	MOVW	76(R1), R28
+	MOVW	80(R1), R29
+	MOVW	84(R1), g
+	FMOVD	96(R1), F14
+	FMOVD	104(R1), F15
+	FMOVD	112(R1), F16
+	FMOVD	120(R1), F17
+	FMOVD	128(R1), F18
+	FMOVD	136(R1), F19
+	FMOVD	144(R1), F20
+	FMOVD	152(R1), F21
+	FMOVD	160(R1), F22
+	FMOVD	168(R1), F23
+	FMOVD	176(R1), F24
+	FMOVD	184(R1), F25
+	FMOVD	192(R1), F26
+	FMOVD	200(R1), F27
+	FMOVD	208(R1), F28
+	FMOVD	216(R1), F29
+	FMOVD	224(R1), F30
+	FMOVD	232(R1), F31
+	MOVW	244(R1), R31
+	MOVW	R31, LR
+	MOVW	88(R1), R31
+	ADD	$240, R1
+	RET
diff --git a/src/runtime/cgo/gcc_ppc.S b/src/runtime/cgo/gcc_ppc.S
new file mode 100644
index 0000000000..31e517e3e1
--- /dev/null
+++ b/src/runtime/cgo/gcc_ppc.S
@@ -0,0 +1,120 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+.file "gcc_ppc.S"
+
+/*
+ * void crosscall1(void (*fn)(void), void (*setg_gcc)(void *g), void *g)
+ *
+ * Calling into the gc tool chain, where all registers are caller save.
+ * Called from the standard 32-bit PowerPC SysV ABI, where r14-r31,
+ * f14-f31 and CR2-CR4 are callee-save, so they must be saved explicitly,
+ * along with LR.
+ * ABI: r3=fn, r4=setg_gcc, r5=g on entry.
+ */
+.set FRAME_SIZE, 240
+.globl crosscall1
+crosscall1:
+	mflr	0
+	stw	0, 4(1)		/* save LR in caller's frame */
+	mfcr	0
+	stw	0, 8(1)		/* save CR in caller's frame (unused area for callees) */
+	stwu	1, -FRAME_SIZE(1)
+	stw	14, 16(1)
+	stw	15, 20(1)
+	stw	16, 24(1)
+	stw	17, 28(1)
+	stw	18, 32(1)
+	stw	19, 36(1)
+	stw	20, 40(1)
+	stw	21, 44(1)
+	stw	22, 48(1)
+	stw	23, 52(1)
+	stw	24, 56(1)
+	stw	25, 60(1)
+	stw	26, 64(1)
+	stw	27, 68(1)
+	stw	28, 72(1)
+	stw	29, 76(1)
+	stw	30, 80(1)
+	stw	31, 84(1)
+	stfd	14, 88(1)
+	stfd	15, 96(1)
+	stfd	16, 104(1)
+	stfd	17, 112(1)
+	stfd	18, 120(1)
+	stfd	19, 128(1)
+	stfd	20, 136(1)
+	stfd	21, 144(1)
+	stfd	22, 152(1)
+	stfd	23, 160(1)
+	stfd	24, 168(1)
+	stfd	25, 176(1)
+	stfd	26, 184(1)
+	stfd	27, 192(1)
+	stfd	28, 200(1)
+	stfd	29, 208(1)
+	stfd	30, 216(1)
+	stfd	31, 224(1)
+
+	/* Set up Go ABI constant registers */
+	li	0, 0
+	/* Save fn in r14 (callee-save) while we call setg_gcc */
+	mr	14, 3
+	/* Restore g pointer (r30 in Go ABI, which may have been clobbered by C) */
+	mr	30, 5
+	/* Call setg_gcc(g) */
+	mr	3, 5
+	mtctr	4
+	bctrl
+	/* Call fn() */
+	mtctr	14
+	bctrl
+
+	lwz	14, 16(1)
+	lwz	15, 20(1)
+	lwz	16, 24(1)
+	lwz	17, 28(1)
+	lwz	18, 32(1)
+	lwz	19, 36(1)
+	lwz	20, 40(1)
+	lwz	21, 44(1)
+	lwz	22, 48(1)
+	lwz	23, 52(1)
+	lwz	24, 56(1)
+	lwz	25, 60(1)
+	lwz	26, 64(1)
+	lwz	27, 68(1)
+	lwz	28, 72(1)
+	lwz	29, 76(1)
+	lwz	30, 80(1)
+	lwz	31, 84(1)
+	lfd	14, 88(1)
+	lfd	15, 96(1)
+	lfd	16, 104(1)
+	lfd	17, 112(1)
+	lfd	18, 120(1)
+	lfd	19, 128(1)
+	lfd	20, 136(1)
+	lfd	21, 144(1)
+	lfd	22, 152(1)
+	lfd	23, 160(1)
+	lfd	24, 168(1)
+	lfd	25, 176(1)
+	lfd	26, 184(1)
+	lfd	27, 192(1)
+	lfd	28, 200(1)
+	lfd	29, 208(1)
+	lfd	30, 216(1)
+	lfd	31, 224(1)
+	addi	1, 1, FRAME_SIZE
+	lwz	0, 8(1)
+	mtcr	0
+	lwz	0, 4(1)
+	mtlr	0
+	blr
+
+#ifdef __ELF__
+.section .note.GNU-stack,"",%progbits
+#endif
