+++ b/src/cmd/go/internal/modfetch/fetch.go
@@ -56,6 +56,11 @@ func (f *Fetcher) Download(ctx context.Context, mod module.Version) (dir string,
 		}
 		f.checkMod(ctx, mod)
 
+		if mod.Path == "golang.org/x/sys" {
+			// linux/ppc supplies files upstream x/sys lacks; see cfg.PPCShimsFor.
+			fsys.AddImplicit(cfg.PPCShimsFor(dir))
+		}
+
 		// If go.mod exists (not an old legacy module), check version is not too new.
 		if data, err := os.ReadFile(filepath.Join(dir, "go.mod")); err == nil {
 			goVersion := gover.GoModLookup(data, "go")
