+	FMOVD	152(R1), F22
+	FMOVD	160(R1), F23
+	FMOVD	168(R1), F24
+	FMOVD	176(R1), F25
+	FMOVD	184(R1), F26
+	FMOVD	192(R1), F27
+	FMOVD	200(R1), F28
+	FMOVD	208(R1), F29
+	FMOVD	216(R1), F30
+	FMOVD	224(R1), F31
+	MOVW	16(R1), R14
+	MOVW	20(R1), R15
+	MOVW	24(R1), R16
+	MOVW	28(R1), R17
+	MOVW	32(R1), R18
+	MOVW	36(R1), R19
+	MOVW	40(R1), R20
+	MOVW	44(R1), R21
+	MOVW	48(R1), R22
+	MOVW	52(R1), R23
+	MOVW	56(R1), R24
+	MOVW	60(R1), R25
+	MOVW	64(R1), R26
+	MOVW	68(R1), R27
+	MOVW	72(R1), R28
+	MOVW	76(R1), R29
+	MOVW	80(R1), g
+	MOVW	84(R1), R31
+	MOVW	12(R1), R13
+	MOVW	8(R1), R12
+	MOVW	R12, CR
+	ADD	$256, R1
+	MOVW	4(R1), R12
+	MOVW	R12, LR
+	RET
+
+// rt0_lib_go initializes the Go runtime.
+// This is started in a separate thread by _rt0_ppc_linux_lib.
+TEXT runtime·rt0_lib_go<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	_rt0_ppc_linux_lib_argc<>(SB), R3
+	MOVW	_rt0_ppc_linux_lib_argv<>(SB), R4
+	BR	runtime·rt0_go(SB)
+
+DATA _rt0_ppc_linux_lib_argc<>(SB)/4, $0
+GLOBL _rt0_ppc_linux_lib_argc<>(SB),NOPTR, $4
+DATA _rt0_ppc_linux_lib_argv<>(SB)/4, $0
+GLOBL _rt0_ppc_linux_lib_argv<>(SB),NOPTR, $4
 
