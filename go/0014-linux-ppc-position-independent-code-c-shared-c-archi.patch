+	MOVW	R28, 72(R1)
+	MOVW	R29, 76(R1)
+	MOVW	g, 80(R1)
+	MOVW	R31, 84(R1)
+	FMOVD	F14, 88(R1)
+	FMOVD	F15, 96(R1)
+	FMOVD	F16, 104(R1)
+	FMOVD	F17, 112(R1)
+	FMOVD	F18, 120(R1)
+	FMOVD	F19, 128(R1)
+	FMOVD	F20, 136(R1)
+	FMOVD	F21, 144(R1)
+	FMOVD	F22, 152(R1)
+	FMOVD	F23, 160(R1)
+	FMOVD	F24, 168(R1)
+	FMOVD	F25, 176(R1)
+	FMOVD	F26, 184(R1)
+	FMOVD	F27, 192(R1)
+	FMOVD	F28, 200(R1)
+	FMOVD	F29, 208(R1)
+	FMOVD	F30, 216(R1)
+	FMOVD	F31, 224(R1)
+
+	MOVW	R3, _rt0_ppc_linux_lib_argc<>(SB)
+	MOVW	R4, _rt0_ppc_linux_lib_argv<>(SB)
+
+	// Set up Go ABI constant registers; there is no g yet.
+	XOR	R0, R0
+	MOVW	R0, g
+
+	// Synchronous initialization, then a new thread runs rt0_lib_go.
+	BL	runtime·libInit(SB)
+
+	FMOVD	88(R1), F14
+	FMOVD	96(R1), F15
+	FMOVD	104(R1), F16
+	FMOVD	112(R1), F17
+	FMOVD	120(R1), F18
+	FMOVD	128(R1), F19
