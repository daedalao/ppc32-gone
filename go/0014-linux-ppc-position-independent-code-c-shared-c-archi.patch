 	XOR	R0, R0	// Make sure R0 is zero before _main
 	BR	_main<>(SB)
 
+// _rt0_ppc_linux_lib is the library constructor for -buildmode=c-shared
+// and -buildmode=c-archive, run from .init_array as
+// void f(int argc, char **argv). C ABI: R3 = argc, R4 = argv; R13-R31,
+// F14-F31 and CR are callee-save, and Go code clobbers all of them
+// (R13 is the module base pointer of position independent Go code).
+// Frame (256 bytes): 0 back chain, 4 LR slot, 8 CR, 12 R13,
+// 16..87 R14-R31, 88..231 F14-F31.
 TEXT _rt0_ppc_linux_lib(SB),NOSPLIT|NOFRAME,$0
-	// -buildmode=c-shared and c-archive are not supported yet.
-	UNDEF
+	MOVW	LR, R12
+	MOVW	R12, 4(R1)	// LR save slot in the caller's frame
+	MOVWU	R1, -256(R1)
+	MOVW	CR, R12
+	MOVW	R12, 8(R1)
+	MOVW	R13, 12(R1)
+	MOVW	R14, 16(R1)
+	MOVW	R15, 20(R1)
+	MOVW	R16, 24(R1)
+	MOVW	R17, 28(R1)
