 		o3 = LOP_RRR(OP_EXTSB, uint32(p.To.Reg), uint32(p.To.Reg), 0)
 
+	case 112: // PICBASE: load the module base pointer into R13 (ppc, 32-bit).
+		// mflr r12; bcl 20,31,$+4; mflr r13; mtlr r12;
+		// addis r13,r13,(runtime.text-here)@ha; addi r13,r13,...@l
+		// See basePreamble in obj9.go.
+		o1 = 0x7d8802a6
+		o2 = 0x429f0005
+		o3 = 0x7da802a6
+		o4 = 0x7d8803a6
+		o5 = 0x3dad0000
+		out[5] = 0x39ad0000
+		// After mflr, R13 holds the address of the mflr instruction
+		// (pc+8); the addis/addi pair is at pc+16. R_ADDRPOWER_PCREL
+		// computes S + A - P, so A = 8 gives runtime.text - (pc+8).
+		c.cursym.AddRel(c.ctxt, obj.Reloc{
+			Type: objabi.R_ADDRPOWER_PCREL,
+			Off:  int32(c.pc) + 16,
+			Siz:  8,
+			Sym:  c.ctxt.Lookup("runtime.text"),
+			Add:  8,
+		})
+
+	case 111: // MOVW tlsvar(SB), R on ppc (32-bit), initial-exec model.
+		// addis R, R13, w@ha; lwz R, w@l(R); add R, R, R2
+		// where w is a data word holding the thread pointer offset of
+		// the variable, filled in by the (host) linker, and R2 is the
+		// thread pointer.
+		if p.From.Offset != 0 {
+			c.ctxt.Diag("invalid offset against tls var %v", p)
+		}
+		w := c.tpoffSym(p.From.Sym)
+		o1 = AOP_IRR(OP_ADDIS, uint32(p.To.Reg), REG_R13, 0)
+		o2 = AOP_IRR(c.opload(AMOVW), uint32(p.To.Reg), uint32(p.To.Reg), 0)
+		o3 = AOP_RRR(OP_ADD, uint32(p.To.Reg), uint32(p.To.Reg), REG_R2)
+		c.cursym.AddRel(c.ctxt, obj.Reloc{
+			Type: objabi.R_ADDRPOWER_TOCREL,
+			Off:  int32(c.pc),
+			Siz:  8,
+			Sym:  w,
+		})
+
 	case 79:
 		if p.From.Offset != 0 {
 			c.ctxt.Diag("invalid offset against tls var %v", p)
@@ -5515,3 +5580,17 @@ func (c *ctxt9) opstorex(a obj.As) uint32 {
 	c.ctxt.Diag("unknown storex opcode %v", a)
 	return 0
 }
+
+// tpoffSym returns the data word "<tls>.tpoff" holding the thread
+// pointer offset of the TLS variable tls, used by initial-exec TLS
+// accesses on ppc (32-bit). The word carries an R_TLS_IE relocation,
+// which the linker turns into R_PPC_TPREL32 for the host linker.
+func (c *ctxt9) tpoffSym(tls *obj.LSym) *obj.LSym {
+	return c.ctxt.LookupInit(tls.Name+".tpoff", func(s *obj.LSym) {
+		s.Type = objabi.SNOPTRDATA
+		s.Set(obj.AttrDuplicateOK, true)
+		s.WriteInt(c.ctxt, 0, 4, 0)
+		s.AddRel(c.ctxt, obj.Reloc{Type: objabi.R_TLS_IE, Off: 0, Siz: 4, Sym: tls})
+		c.ctxt.Data = append(c.ctxt.Data, s)
+	})
+}
