diff --git a/misc/ppc/xsys/unix/asm_linux_ppc.s b/misc/ppc/xsys/unix/asm_linux_ppc.s
new file mode 100644
index 0000000000..a5c0371bda
--- /dev/null
+++ b/misc/ppc/xsys/unix/asm_linux_ppc.s
@@ -0,0 +1,54 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build linux && ppc && gc
+
+#include "textflag.h"
+
+//
+// System calls for ppc, Linux
+//
+
+// Just jump to package syscall's implementation for all these functions.
+// The runtime may know about them.
+
+TEXT ·Syscall(SB),NOSPLIT,$0-28
+	JMP	syscall·Syscall(SB)
+
+TEXT ·Syscall6(SB),NOSPLIT,$0-40
+	JMP	syscall·Syscall6(SB)
+
+TEXT ·SyscallNoError(SB),NOSPLIT,$0-24
+	BL	runtime·entersyscall(SB)
+	MOVW	a1+4(FP), R3
+	MOVW	a2+8(FP), R4
+	MOVW	a3+12(FP), R5
+	MOVW	R0, R6
+	MOVW	R0, R7
+	MOVW	R0, R8
+	MOVW	trap+0(FP), R9	// syscall entry
+	SYSCALL	R9
+	MOVW	R3, r1+16(FP)
+	MOVW	R0, r2+20(FP)	// r2 is not used on linux/ppc
+	BL	runtime·exitsyscall(SB)
+	RET
+
+TEXT ·RawSyscall(SB),NOSPLIT,$0-28
+	JMP	syscall·RawSyscall(SB)
+
+TEXT ·RawSyscall6(SB),NOSPLIT,$0-40
+	JMP	syscall·RawSyscall6(SB)
+
+TEXT ·RawSyscallNoError(SB),NOSPLIT,$0-24
+	MOVW	a1+4(FP), R3
+	MOVW	a2+8(FP), R4
+	MOVW	a3+12(FP), R5
+	MOVW	R0, R6
+	MOVW	R0, R7
+	MOVW	R0, R8
+	MOVW	trap+0(FP), R9	// syscall entry
+	SYSCALL	R9
+	MOVW	R3, r1+16(FP)
+	MOVW	R0, r2+20(FP)	// r2 is not used on linux/ppc
+	RET
diff --git a/src/cmd/go/internal/cfg/cfg.go b/src/cmd/go/internal/cfg/cfg.go
index 5c34612f5d..d120b0c50f 100644
--- a/src/cmd/go/internal/cfg/cfg.go
+++ b/src/cmd/go/internal/cfg/cfg.go
@@ -708,3 +708,58 @@ func (d *dirInfo) Mode() fs.FileMode { return d.dir.Type() }
 func (d *dirInfo) Size() int64        { panic("dirInfo.Size") }
 func (d *dirInfo) ModTime() time.Time { panic("dirInfo.ModTime") }
 func (d *dirInfo) Sys() any           { panic("dirInfo.Sys") }
+
+func init() {
+	fsys.Implicit = ppcShims
+}
+
+// ppcShims returns overlay entries that add files to copies of
+// golang.org/x/sys in the module cache (or a vendor directory) when
+// building for GOARCH=ppc. Upstream x/sys has no gc assembly for
+// linux/ppc and no cpu package support for ppc; the linux/ppc port
+// ships them in $GOROOT/misc/ppc/xsys. Entries are only added for
+// directories that exist and do not already contain the file, so
+// a future upstream x/sys that ships them wins automatically.
+func ppcShims() map[string]string {
+	if Goarch != "ppc" {
+		return nil
+	}
+	shim := filepath.Join(GOROOT, "misc", "ppc", "xsys")
+	if _, err := os.Stat(shim); err != nil {
+		return nil
+	}
+	files := [][2]string{{"unix", "asm_linux_ppc.s"}, {"cpu", "cpu_ppc.go"}}
+	m := make(map[string]string)
+	add := func(mod string) {
+		for _, f := range files {
+			dir := filepath.Join(mod, f[0])
+			if _, err := os.Stat(dir); err != nil {
+				continue
+			}
+			p := filepath.Join(dir, f[1])
+			if _, err := os.Stat(p); err == nil {
+				continue // the module ships its own copy
+			}
+			m[p] = filepath.Join(shim, f[0], f[1])
+		}
+	}
+	mods, _ := filepath.Glob(filepath.Join(GOMODCACHE, "golang.org", "x", "sys@*"))
+	for _, mod := range mods {
+		add(mod)
+	}
+	// A vendored copy in the main module (or an enclosing one).
+	if dir, err := os.Getwd(); err == nil {
+		for {
+			if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+				add(filepath.Join(dir, "vendor", "golang.org", "x", "sys"))
+				break
+			}
+			parent := filepath.Dir(dir)
+			if parent == dir {
+				break
+			}
+			dir = parent
+		}
+	}
+	return m
+}
diff --git a/src/cmd/go/internal/fsys/fsys.go b/src/cmd/go/internal/fsys/fsys.go
index 0e0821a35f..cd24d65b56 100644
--- a/src/cmd/go/internal/fsys/fsys.go
