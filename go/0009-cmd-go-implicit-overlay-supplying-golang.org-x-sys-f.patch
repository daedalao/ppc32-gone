+// Implicit, if set, returns additional overlay entries (old path to
+// replacement path) that are applied after the -overlay file.
+// The linux/ppc port uses it to supply files for golang.org/x/sys that
+// upstream does not ship for GOARCH=ppc (see cfg.ppcShims).
+var Implicit func() map[string]string
+
+// implicit records the absolute "from" paths that came from Implicit
+// rather than from the -overlay file. DirContainsReplacement ignores
+// them, so they may add files beneath GOMODCACHE.
+var implicitPaths map[string]bool
+
 // Bind makes the virtual file system use dir as if it were mounted at mtpt,
 // like Plan 9's “bind” or Linux's “mount --bind”, or like os.Symlink
 // but without the symbolic link.
@@ -346,22 +357,42 @@ func Init() error {
 		return nil
 	}
 
-	if OverlayFile == "" {
+	var implicit map[string]string
+	if Implicit != nil {
+		implicit = Implicit()
+	}
+	if OverlayFile == "" && len(implicit) == 0 {
 		return nil
 	}
 
-	Trace("ReadFile", OverlayFile)
-	b, err := os.ReadFile(OverlayFile)
-	if err != nil {
-		return fmt.Errorf("reading overlay: %v", err)
+	var b []byte
+	if OverlayFile != "" {
+		Trace("ReadFile", OverlayFile)
+		var err error
+		b, err = os.ReadFile(OverlayFile)
+		if err != nil {
+			return fmt.Errorf("reading overlay: %v", err)
+		}
 	}
-	return initFromJSON(b)
+	return initFromJSON(b, implicit)
 }
 
-func initFromJSON(js []byte) error {
+func initFromJSON(js []byte, implicit map[string]string) error {
 	var ojs overlayJSON
-	if err := json.Unmarshal(js, &ojs); err != nil {
-		return fmt.Errorf("parsing overlay JSON: %v", err)
+	if len(js) > 0 {
+		if err := json.Unmarshal(js, &ojs); err != nil {
+			return fmt.Errorf("parsing overlay JSON: %v", err)
+		}
+	}
+	implicitFrom := make(map[string]bool)
+	for from, to := range implicit {
+		if ojs.Replace == nil {
+			ojs.Replace = make(map[string]string)
+		}
+		if _, ok := ojs.Replace[from]; !ok {
+			ojs.Replace[from] = to
+			implicitFrom[abs(from)] = true
+		}
 	}
 
 	seen := make(map[string]string)
@@ -398,6 +429,7 @@ func initFromJSON(js []byte) error {
 	}
 
 	overlay = list
+	implicitPaths = implicitFrom
 	return nil
 }
 
@@ -520,6 +552,29 @@ func Replaced(name string) bool {
 	return info.deleted || info.replaced && !info.dir
 }
 
+// HasOverlay reports whether any overlay entries are in effect,
+// whether from the -overlay file or from Implicit.
+func HasOverlay() bool {
+	return len(overlay) > 0
+}
+
+// ImplicitUnder returns the sorted implicit overlay paths beneath dir.
+// It lets callers that cache per-directory state (such as the module
+// index) account for implicit additions.
+func ImplicitUnder(dir string) []string {
+	if len(implicitPaths) == 0 {
+		return nil
+	}
+	adir := abs(dir)
+	var list []string
+	for _, r := range overlay {
+		if implicitPaths[r.from] && str.HasFilePathPrefix(r.from, adir) {
+			list = append(list, r.from)
+		}
+	}
+	return list
+}
+
 // DirContainsReplacement reports whether the named directory is affected by a replacement,
 // either because a parent directory has been replaced, it has been replaced, or a file or
 // directory under it has been replaced.
@@ -530,16 +585,16 @@ func DirContainsReplacement(name string) (string, bool) {
 	apath := abs(name)
 
 	// Check the overlay using similar logic to what stat uses.
-	i, ok := slices.BinarySearchFunc(overlay, apath, searchcmp)
-	if ok {
-		// The named directory itself has been replaced.
-		return overlay[i].from, true
-	}
-	if i < len(overlay) && str.HasFilePathPrefix(overlay[i].from, apath) {
-		// A file or directory contained in the named directory has been replaced.
-		return overlay[i].from, true
+	// Entries that came from Implicit are ignored.
+	i, _ := slices.BinarySearchFunc(overlay, apath, searchcmp)
+	for j := i; j < len(overlay) && str.HasFilePathPrefix(overlay[j].from, apath); j++ {
+		// The named directory itself, or a file or directory
+		// contained in it, has been replaced.
+		if !implicitPaths[overlay[j].from] {
+			return overlay[j].from, true
+		}
 	}
-	if i > 0 && str.HasFilePathPrefix(apath, overlay[i-1].from) {
+	if i > 0 && str.HasFilePathPrefix(apath, overlay[i-1].from) && !implicitPaths[overlay[i-1].from] {
 		// A parent of the named directory has been replaced.
 		return overlay[i-1].from, true
 	}
