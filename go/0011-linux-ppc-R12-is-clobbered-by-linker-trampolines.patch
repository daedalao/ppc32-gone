From b520d78e34f39dc7e29beea99b8514f250dde40e Mon Sep 17 00:00:00 2001
From: daedalao <daedalao@hotmail.com>
Date: Wed, 9 Sep 2026 03:16:24 -0700
Subject: [PATCH 11/16] linux/ppc: R12 is clobbered by linker trampolines

Linker trampolines use R12 as scratch, so no register allocation or
assembly may keep a value in R12 across a call. LoweredWB (the write
barrier call, which otherwise preserves registers) now clobbers R12
alongside the scratch registers gcWriteBarrier<> uses, matching ppc64.
asmcgocall kept the C function pointer in R12 across two calls; move
it to R14.

Found with go test -ldflags=-debugtramp=2 runtime on the G4.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0117Su2urNmg96oYM6vhHi1y
---
 src/cmd/compile/internal/ssa/_gen/PPCOps.go | 4 +++-
 src/cmd/compile/internal/ssa/ssaop/opGen.go | 2 +-
 src/runtime/asm_ppc.s                       | 4 +++-
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/cmd/compile/internal/ssa/_gen/PPCOps.go b/src/cmd/compile/internal/ssa/_gen/PPCOps.go
index b875b0b004..0f74bcdb92 100644
--- a/src/cmd/compile/internal/ssa/_gen/PPCOps.go
+++ b/src/cmd/compile/internal/ssa/_gen/PPCOps.go
@@ -480,7 +480,9 @@ func init() {
 		// It saves all GP registers if necessary,
 		// but clobbers R31 (REGTMP) and the carry bit, and LR because it is a call.
 		// Returns a pointer to a write barrier buffer in R29.
-		{name: "LoweredWB", argLength: 1, reg: regInfo{clobbers: tmp, outputs: []regMask{buildReg("R29")}}, clobberFlags: true, aux: "Int64"},
+		// It preserves every register except R12 (used by linker trampolines),
+		// R18, R19 and R31 (scratch in gcWriteBarrier<>) and R29 (output).
+		{name: "LoweredWB", argLength: 1, reg: regInfo{clobbers: buildReg("R12 R18 R19 R31"), outputs: []regMask{buildReg("R29")}}, clobberFlags: true, aux: "Int64"},
 
 		{name: "LoweredPubBarrier", argLength: 1, asm: "SYNC", hasSideEffects: true}, // Do data barrier. arg0=memory
 
diff --git a/src/cmd/compile/internal/ssa/ssaop/opGen.go b/src/cmd/compile/internal/ssa/ssaop/opGen.go
index 7a05519e09..a0ed083673 100644
--- a/src/cmd/compile/internal/ssa/ssaop/opGen.go
+++ b/src/cmd/compile/internal/ssa/ssaop/opGen.go
@@ -97781,7 +97781,7 @@ var OpcodeTable = [...]OpInfo{
 		ArgLen:       1,
 		ClobberFlags: true,
 		Reg: RegInfo{
-			Clobbers: RegMask{V1: 2147483648, V2: 0}, // R31
+			Clobbers: RegMask{V1: 2148274176, V2: 0}, // R12 R18 R19 R31
 			Outputs: []OutputInfo{
 				{0, RegMask{V1: 536870912, V2: 0}}, // R29
 			},
diff --git a/src/runtime/asm_ppc.s b/src/runtime/asm_ppc.s
index 9a7bbdbb26..47148b0e76 100644
--- a/src/runtime/asm_ppc.s
+++ b/src/runtime/asm_ppc.s
@@ -473,7 +473,7 @@ TEXT gosave_systemstack_switch<>(SB),NOSPLIT|NOFRAME,$0
 // aligned appropriately for the gcc ABI.
 // See cgocall.go for more details.
 TEXT ·asmcgocall(SB),NOSPLIT,$0-12
-	MOVW	fn+0(FP), R12
+	MOVW	fn+0(FP), R14	// keep fn out of R12: linker trampolines clobber it
 	MOVW	arg+4(FP), R4
 
 	MOVW	R1, R7		// save original stack pointer
@@ -508,6 +508,7 @@ TEXT ·asmcgocall(SB),NOSPLIT,$0-12
 	SUB	R7, R5
 	MOVW	R5, 20(R1)	// save depth in old g stack (can't just save SP, as stack might be copied during a callback)
 	MOVW	R0, 0(R1)	// clear back chain pointer
+	MOVW	R14, R12
 	MOVW	R12, CTR
 	MOVW	R4, R3		// arg in r3
 	BL	(CTR)
@@ -540,6 +541,7 @@ nosave:
 	RLWNM	$0, R1, $0xfffffff0, R1
 	MOVW	R7, 16(R1)	// save original stack pointer
 	MOVW	R0, 0(R1)	// clear back chain pointer
+	MOVW	R14, R12
 	MOVW	R12, CTR
 	MOVW	R4, R3		// arg in r3
 	BL	(CTR)
-- 
