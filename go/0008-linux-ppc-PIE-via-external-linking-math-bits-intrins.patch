+++ b/src/cmd/compile/internal/ssa/_gen/PPC.rules
@@ -192,6 +192,9 @@
 
 // bit length
 (BitLen32 <t> x) => (SUBFCconst [32] (CNTLZW <t> x))
+
+(Abs ...) => (FABS ...)
+(FMA ...) => (FMADD ...)
 (BitLen(16|8) x) => (BitLen32 (ZeroExt(16|8)to32 x))
 
