@@ -9,6 +9,9 @@ import "cmd/compile/internal/ssa"
 
 func RewriteValue(v *ssa.Value) bool {
 	switch v.Op {
+	case ssaop.OpAbs:
+		v.Op = ssaop.OpPPCFABS
+		return true
 	case ssaop.OpAdd16:
 		v.Op = ssaop.OpPPCADD
 		return true
@@ -184,6 +187,9 @@ func RewriteValue(v *ssa.Value) bool {
 		return rewriteValue_OpEqB(v)
 	case ssaop.OpEqPtr:
 		return rewriteValue_OpEqPtr(v)
+	case ssaop.OpFMA:
+		v.Op = ssaop.OpPPCFMADD
+		return true
 	case ssaop.OpGetCallerPC:
 		v.Op = ssaop.OpPPCLoweredGetCallerPC
 		return true
