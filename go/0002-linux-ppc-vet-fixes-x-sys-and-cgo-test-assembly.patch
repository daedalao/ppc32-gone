 	MOVW	FIXED_FRAME+0(R1), R5	// sec (int32)
 	MOVW	FIXED_FRAME+4(R1), R6	// nsec
 	SRAW	$31, R5, R7		// sign extend sec to int64
-	MOVW	R7, sec+0(FP)
-	MOVW	R5, sec+4(FP)
+	MOVW	R7, sec_hi+0(FP)
