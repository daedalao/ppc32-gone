 	MOVW	FIXED_FRAME+4(R1), R6	// sec lo
 	MOVW	FIXED_FRAME+12(R1), R7	// nsec (low word of the 64-bit field)
-	MOVW	R5, sec+0(FP)
-	MOVW	R6, sec+4(FP)
+	MOVW	R5, sec_hi+0(FP)
+	MOVW	R6, sec_lo+4(FP)
 	MOVW	R7, nsec+8(FP)
 	RET
 
@@ -273,8 +273,8 @@ compute:
 	ADD	R11, R9
 	ADDC	R7, R10		// lo += nsec
 	ADDZE	R9, R9		// hi += carry
-	MOVW	R9, ret+0(FP)
-	MOVW	R10, ret+4(FP)
+	MOVW	R9, ret_hi+0(FP)
+	MOVW	R10, ret_lo+4(FP)
 	RET
 
