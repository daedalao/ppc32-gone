index 0000000000..31d05f76f9
--- /dev/null
+++ b/src/cmd/cgo/internal/test/issue9400/asm_ppc.s
@@ -0,0 +1,30 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build ppc && gc
+
+#include "textflag.h"
+
+TEXT ·RewindAndSetgid(SB),NOSPLIT|NOFRAME,$0-0
+	// Rewind stack pointer so anything that happens on the stack
+	// will clobber the test pattern created by the caller
+	ADD	$(1024*8), R1
+
+	// Ask signaller to setgid
+	MOVW	$1, R3
+	SYNC
+	MOVW	R3, ·Baton(SB)
+	SYNC
+
+	// Wait for setgid completion
+loop:
+	SYNC
+	MOVW	·Baton(SB), R3
+	CMPW	R3, $0
+	BNE	loop
+	SYNC
+
+	// Restore stack
+	ADD	$(-1024*8), R1
+	RET
diff --git a/src/cmd/vendor/golang.org/x/sys/unix/asm_linux_ppc.s b/src/cmd/vendor/golang.org/x/sys/unix/asm_linux_ppc.s
new file mode 100644
index 0000000000..de81368ed7
--- /dev/null
+++ b/src/cmd/vendor/golang.org/x/sys/unix/asm_linux_ppc.s
@@ -0,0 +1,54 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build linux && ppc && gc
+
+#include "textflag.h"
+
+//
+// System calls for ppc, Linux
+//
+
+// Just jump to package syscall's implementation for all these functions.
+// The runtime may know about them.
+
+TEXT ·Syscall(SB),NOSPLIT,$0-28
+	JMP	syscall·Syscall(SB)
+
+TEXT ·Syscall6(SB),NOSPLIT,$0-40
+	JMP	syscall·Syscall6(SB)
+
+TEXT ·SyscallNoError(SB),NOSPLIT,$0-24
+	BL	runtime·entersyscall(SB)
+	MOVW	a1+4(FP), R3
+	MOVW	a2+8(FP), R4
+	MOVW	a3+12(FP), R5
+	MOVW	R0, R6
+	MOVW	R0, R7
+	MOVW	R0, R8
+	MOVW	trap+0(FP), R9	// syscall entry
+	SYSCALL	R9
+	MOVW	R3, r1+16(FP)
+	MOVW	R4, r2+20(FP)
+	BL	runtime·exitsyscall(SB)
+	RET
+
+TEXT ·RawSyscall(SB),NOSPLIT,$0-28
+	JMP	syscall·RawSyscall(SB)
+
+TEXT ·RawSyscall6(SB),NOSPLIT,$0-40
+	JMP	syscall·RawSyscall6(SB)
+
+TEXT ·RawSyscallNoError(SB),NOSPLIT,$0-24
+	MOVW	a1+4(FP), R3
+	MOVW	a2+8(FP), R4
+	MOVW	a3+12(FP), R5
+	MOVW	R0, R6
+	MOVW	R0, R7
+	MOVW	R0, R8
+	MOVW	trap+0(FP), R9	// syscall entry
+	SYSCALL	R9
+	MOVW	R3, r1+16(FP)
+	MOVW	R4, r2+20(FP)
+	RET
