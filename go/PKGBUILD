prepare() {
  cd go
  local p
  for p in "$srcdir"/*.patch; do
    msg2 "Applying $(basename "$p")"
    git apply "$p"
  done
  # cmd/dist derives the version from git; the port's commits make that
  # "go1.28-devel_...". Give the package a stable version string instead.
  printf 'go%s\ntime %s\n' "$pkgver" "$(date -u -d @${SOURCE_DATE_EPOCH:-$(date +%s)} +%Y-%m-%dT%H:%M:%SZ)" > VERSION
}

build() {
  export GOROOT_FINAL=/usr/lib/go
  # Disable dwarf5 until debugedit catches up (as in the Arch PKGBUILD).
  export GOEXPERIMENT=nodwarf5
  # Build scratch can exceed a small tmpfs /tmp (the G4 has 1 GB).
  export GOTMPDIR="$srcdir/tmp"; mkdir -p "$GOTMPDIR"
  unset GOROOT GOFLAGS

  cd go/src
  if [[ "$(go env GOHOSTARCH)" == ppc ]]; then
    # Native build with the installed go.
    export GOROOT_BOOTSTRAP=/usr/lib/go
    ./make.bash -v
  else
    # Cross build: host go compiles the ppc toolchain and standard library.
    export GOROOT_BOOTSTRAP="$(go env GOROOT)"
    export GOOS=linux GOARCH=ppc
    # Do not set CGO_ENABLED: cmd/dist bakes an explicit value into the
    # toolchain as its permanent default. Left unset, the cross build skips
    # runtime/cgo and the installed go decides at run time (cgo works on
    # the target when a C compiler is present).
    unset CGO_ENABLED
    # cmd/dist likewise bakes the C compiler name in as the toolchain's
    # default CC. Record the target's compiler, not the host's; this is
    # also the name of the native gcc on an Arch POWER 32-bit system.
    export CC_FOR_TARGET="${CC_FOR_TARGET:-powerpc-unknown-linux-gnu-gcc}"
    ./make.bash -v --no-banner
    local hostos hostarch
    hostos="$(../bin/go env GOHOSTOS)"
    hostarch="$(../bin/go env GOHOSTARCH)"
    cd ..
    # Same layout as bootstrap.bash: keep only the ppc tools and packages.
    rm -f bin/go_linux_ppc_exec
    mv bin/linux_ppc/* bin/
    rmdir bin/linux_ppc
    rm -rf "pkg/${hostos}_${hostarch}" "pkg/tool/${hostos}_${hostarch}"
  fi
}

package() {
  cd go

  install -d "$pkgdir/usr/bin" "$pkgdir/usr/lib/go" "$pkgdir/usr/share/doc/go"

  cp -a bin pkg src lib misc api test "$pkgdir/usr/lib/go"
  # Strip only the packaged binaries; stripping testdata breaks the tests.
  # Use the cross strip when building on another architecture.
  local strip=strip
  [[ "$(uname -m)" != ppc ]] && command -v powerpc-unknown-linux-gnu-strip >/dev/null && strip=powerpc-unknown-linux-gnu-strip
  $strip $STRIP_BINARIES "$pkgdir/usr/lib/go"{/bin/*,/pkg/tool/*/*}

  cp -r doc/* "$pkgdir/usr/share/doc/go"

  ln -sf /usr/lib/go/bin/go "$pkgdir/usr/bin/go"
  ln -sf /usr/lib/go/bin/gofmt "$pkgdir/usr/bin/gofmt"
  ln -sf /usr/share/doc/go "$pkgdir/usr/lib/go/doc"

  install -Dm644 VERSION "$pkgdir/usr/lib/go/VERSION"

  rm -rf "$pkgdir/usr/lib/go/pkg/bootstrap"
  rm -rf "$pkgdir"/usr/lib/go/pkg/obj/go-build

  # https://github.com/golang/go/issues/57179
  install -Dm644 go.env "$pkgdir/usr/lib/go/go.env"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

