# Maintainer: daedalao <daedalao@hotmail.com>
# Based on the Arch Linux go PKGBUILD by Morten Linderud <foxboron@archlinux.org>
#
# Go for Arch POWER 32-bit (linux/ppc). Upstream Go has no 32-bit PowerPC
# target, so this builds upstream master at the commit the port was written
# against plus the port itself as a patch series (see README.md).
#
# It can be built two ways:
#   * cross, on any Arch machine with a working go (ppc64le, x86_64, ...):
#       CARCH=powerpc makepkg
#     make.bash builds the ppc32 toolchain with the host go and the tree is
#     laid out like bootstrap.bash does. No ppc bootstrap toolchain needed.
#   * natively on a powerpc machine that already has this package installed
#     (GOROOT_BOOTSTRAP=/usr/lib/go, ~70 minutes on a 1.67 GHz G4).

pkgname=go
epoch=2
pkgver=1.28.ppc32
pkgrel=5
_commit=a14b5433261d7ed98b716b0c71e36a46b7148ef2 # go master, 2026-09-08
pkgdesc='Core compiler tools for the Go programming language (linux/ppc port)'
arch=(powerpc)
url='https://go.dev/'
license=(BSD-3-Clause)
makedepends=(git go)
replaces=(go-pie)
provides=(go-pie)
options=(!strip staticlibs)
source=("git+https://go.googlesource.com/go#commit=$_commit"
        "0001-all-add-linux-ppc-32-bit-big-endian-PowerPC-port.patch"
        "0002-linux-ppc-vet-fixes-x-sys-and-cgo-test-assembly.patch"
        "0003-syscall-linux-ppc-64-bit-args-need-aligned-register-.patch"
        "0004-cmd-compile-linux-ppc-indirect-calls-must-go-through.patch"
        "0005-linux-ppc-enable-cgo-external-linking.patch"
        "0006-linux-ppc-register-32-bit-atomic-intrinsics-fix-big-.patch"
        "0007-cmd-dist-detect-ppc-host-uname-m-output-has-a-traili.patch"
        "0008-linux-ppc-PIE-via-external-linking-math-bits-intrins.patch"
        "0009-cmd-go-implicit-overlay-supplying-golang.org-x-sys-f.patch"
        "0010-cmd-link-trampolines-for-linux-ppc.patch"
        "0011-linux-ppc-R12-is-clobbered-by-linker-trampolines.patch"
        "0012-runtime-fix-TestBadTraceback-frame-offset-for-linux-.patch"
        "0013-runtime-drop-SIGPROF-samples-taken-inside-emulated-6.patch"
        "0014-linux-ppc-position-independent-code-c-shared-c-archi.patch"
        "0015-linux-ppc-buildmode-shared-and-linkshared-PC-relativ.patch")
