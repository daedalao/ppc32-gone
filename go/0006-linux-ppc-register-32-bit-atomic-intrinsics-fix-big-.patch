diff --git a/src/internal/runtime/maps/runtime_hash32.go b/src/internal/runtime/maps/runtime_hash32.go
index caac448b35..40320ef9c3 100644
--- a/src/internal/runtime/maps/runtime_hash32.go
+++ b/src/internal/runtime/maps/runtime_hash32.go
@@ -9,7 +9,10 @@
 
 package maps
 
-import "unsafe"
+import (
+	"internal/goarch"
+	"unsafe"
+)
 
 func memHash32Fallback(k uint32, seed uintptr) uintptr {
 	a, b := mix32(uint32(seed), uint32(4^hashkey[0]))
@@ -22,8 +25,15 @@ func memHash32Fallback(k uint32, seed uintptr) uintptr {
 
 func memHash64Fallback(k uint64, seed uintptr) uintptr {
 	a, b := mix32(uint32(seed), uint32(8^hashkey[0]))
-	a ^= uint32(k)
-	b ^= uint32(k >> 32)
+	// Mix the two halves in memory order so that the result matches
+	// memHashFallback on the same 8 bytes, on both endiannesses.
+	if goarch.BigEndian {
+		a ^= uint32(k >> 32)
+		b ^= uint32(k)
+	} else {
+		a ^= uint32(k)
+		b ^= uint32(k >> 32)
+	}
 	a, b = mix32(a, b)
 	a, b = mix32(a, b)
 	return uintptr(a ^ b)
