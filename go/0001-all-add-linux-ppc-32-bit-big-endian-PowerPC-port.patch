diff --git a/src/cmd/link/internal/ppc/asm.go b/src/cmd/link/internal/ppc/asm.go
new file mode 100644
index 0000000000..d0290c3db3
--- /dev/null
+++ b/src/cmd/link/internal/ppc/asm.go
@@ -0,0 +1,207 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Linker support for linux/ppc (32-bit, big-endian, SysV ABI).
+//
+// The 32-bit port reuses the ppc64 relocation types generated by
+// cmd/internal/obj/ppc64: R_ADDRPOWER (addis/addi or addis/load pairs
+// carrying a 32-bit absolute address split into HA/LO halves),
+// R_CALLPOWER (26-bit relative branch) and R_POWER_TLS_LE (addis/addi
+// pair relative to the thread pointer in R2).
+
+package ppc
+
+import (
+	"cmd/internal/objabi"
+	"cmd/internal/sys"
+	"cmd/link/internal/ld"
+	"cmd/link/internal/loader"
+	"cmd/link/internal/sym"
+	"debug/elf"
+	"encoding/binary"
+)
+
+func gentext(ctxt *ld.Link, ldr *loader.Loader) {
+}
+
+func adddynrel(target *ld.Target, ldr *loader.Loader, syms *ld.ArchSyms, s loader.Sym, r loader.Reloc, rIdx int) bool {
+	ld.Exitf("adddynrel currently unimplemented for ppc")
+	return false
+}
+
+func elfreloc1(ctxt *ld.Link, out *ld.OutBuf, ldr *loader.Loader, s loader.Sym, r loader.ExtReloc, ri int, sectoff int64) bool {
+	elfsym := ld.ElfSymForReloc(ctxt, r.Xsym)
+
+	// Helper to write one Elf32_Rela entry.
+	write := func(rtyp elf.R_PPC, offset int64, addend int64) {
+		out.Write32(uint32(offset))
+		out.Write32(uint32(rtyp) | uint32(elfsym)<<8)
+		out.Write32(uint32(addend))
+	}
+
+	// The 16-bit immediate field sits in the low half of each
+	// big-endian instruction word, two bytes past the start.
+	const fixupBe = 2
+
+	switch r.Type {
+	default:
+		return false
+	case objabi.R_ADDR, objabi.R_DWARFSECREF:
+		if r.Size != 4 {
+			return false
+		}
+		write(elf.R_PPC_ADDR32, sectoff, r.Xadd)
+	case objabi.R_ADDRPOWER:
+		write(elf.R_PPC_ADDR16_HA, sectoff+fixupBe, r.Xadd)
+		write(elf.R_PPC_ADDR16_LO, sectoff+fixupBe+4, r.Xadd)
+	case objabi.R_POWER_TLS_LE:
+		write(elf.R_PPC_TPREL16_HA, sectoff+fixupBe, r.Xadd)
+		write(elf.R_PPC_TPREL16_LO, sectoff+fixupBe+4, r.Xadd)
+	case objabi.R_CALLPOWER:
+		if r.Size != 4 {
+			return false
+		}
+		write(elf.R_PPC_REL24, sectoff, r.Xadd)
+	}
+	return true
+}
+
+func elfsetupplt(ctxt *ld.Link, ldr *loader.Loader, plt, gotplt *loader.SymbolBuilder, dynamic loader.Sym) {
+}
+
+func machoreloc1(*sys.Arch, *ld.OutBuf, *loader.Loader, loader.Sym, loader.ExtReloc, int64) bool {
+	return false
+}
+
+// unpackInstPair splits a 64-bit relocation value into its two
+// big-endian instruction words.
+func unpackInstPair(r int64) (uint32, uint32) {
+	return uint32(r >> 32), uint32(r)
+}
+
+func packInstPair(o1, o2 uint32) int64 {
+	return (int64(o1) << 32) | int64(o2)
+}
+
+// computeHA returns the high-adjusted half of val, per the ELF ABI.
+func computeHA(val int32) uint32 {
+	return uint32(uint16((val + 0x8000) >> 16))
+}
+
+func computeLO(val int32) uint32 {
+	return uint32(uint16(val))
+}
+
+func archreloc(target *ld.Target, ldr *loader.Loader, syms *ld.ArchSyms, r loader.Reloc, s loader.Sym, val int64) (o int64, nExtReloc int, ok bool) {
+	rs := r.Sym()
+	if target.IsExternal() {
+		switch r.Type() {
+		default:
+			return val, 0, false
+		case objabi.R_ADDRPOWER, objabi.R_POWER_TLS_LE:
+			return val, 2, true // two ELF relocations, see elfreloc1
+		case objabi.R_CALLPOWER:
+			return val, 1, true
+		}
+	}
+
+	switch r.Type() {
+	case objabi.R_ADDRPOWER:
+		t := ldr.SymAddr(rs) + r.Add()
+		if t < 0 || t >= 1<<31 {
+			ldr.Errorf(s, "relocation for %s is too big (>=2G): 0x%x", ldr.SymName(s), t)
+		}
+		o1, o2 := unpackInstPair(val)
+		o1 &^= 0xffff
+		o2 &^= 0xffff
+		o1 |= computeHA(int32(t))
+		o2 |= computeLO(int32(t))
+		return packInstPair(o1, o2), 0, true
+
+	case objabi.R_CALLPOWER:
+		// Bits 6 through 29 = (S + A - P) >> 2
+		t := ldr.SymValue(rs) + r.Add() - (ldr.SymValue(s) + int64(r.Off()))
+		if t&3 != 0 {
+			ldr.Errorf(s, "relocation for %s+%d is not aligned: %d", ldr.SymName(rs), r.Off(), t)
+		}
+		if int64(int32(t<<6)>>6) != t {
+			ldr.Errorf(s, "direct call too far: %s %x", ldr.SymName(rs), t)
+		}
+		return val | int64(uint32(t)&^0xfc000003), 0, true
+
+	case objabi.R_POWER_TLS_LE:
+		// The thread pointer (R2) points 0x7000 bytes past the start
+		// of the TLS block, as documented in the 32-bit PowerPC ELF
+		// TLS ABI.
+		v := ldr.SymValue(rs) + r.Add() - 0x7000
+		if int64(int32(v)) != v {
+			ldr.Errorf(s, "TLS offset out of range %d", v)
+		}
+		o1, o2 := unpackInstPair(val)
+		o1 |= computeHA(int32(v))
+		o2 |= computeLO(int32(v))
+		return packInstPair(o1, o2), 0, true
+	}
+
+	return val, 0, false
+}
+
+func archrelocvariant(target *ld.Target, ldr *loader.Loader, r loader.Reloc, rv sym.RelocVariant, s loader.Sym, t int64, p []byte) int64 {
+	rs := r.Sym()
+	switch rv & sym.RV_TYPE_MASK {
+	default:
+		ldr.Errorf(s, "unexpected relocation variant %d", rv)
+		fallthrough
+	case sym.RV_NONE:
+		return t
+	case sym.RV_POWER_LO:
+		if rv&sym.RV_CHECK_OVERFLOW != 0 {
+			o1 := binary.BigEndian.Uint32(p[r.Off()-2:])
+			switch o1 >> 26 {
+			case 24, 26, 28: // ori, xori, andi
+				if t>>16 != 0 {
+					goto overflow
+				}
+			default:
+				if int64(int16(t)) != t {
+					goto overflow
+				}
+			}
+		}
+		return int64(int16(t))
+	case sym.RV_POWER_HA:
+		t += 0x8000
+		fallthrough
+	case sym.RV_POWER_HI:
+		t >>= 16
+		if rv&sym.RV_CHECK_OVERFLOW != 0 {
+			o1 := binary.BigEndian.Uint32(p[r.Off()-2:])
+			switch o1 >> 26 {
+			case 25, 27, 29: // oris, xoris, andis
+				if t>>16 != 0 {
+					goto overflow
+				}
+			default:
+				if int64(int16(t)) != t {
+					goto overflow
+				}
+			}
+		}
+		return int64(int16(t))
+	}
+
+overflow:
+	ldr.Errorf(s, "relocation for %s+%d is too big: %d", ldr.SymName(rs), r.Off(), t)
+	return t
+}
+
+func extreloc(target *ld.Target, ldr *loader.Loader, r loader.Reloc, s loader.Sym) (loader.ExtReloc, bool) {
+	switch r.Type() {
+	case objabi.R_POWER_TLS_LE, objabi.R_CALLPOWER:
+		return ld.ExtrelocSimple(ldr, r), true
+	case objabi.R_ADDRPOWER:
+		return ld.ExtrelocViaOuterSym(ldr, r, s), true
+	}
+	return loader.ExtReloc{}, false
+}
