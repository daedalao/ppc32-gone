+	MOVW	g_m(g), R8
+	MOVW	m_g0(R8), R3
+	MOVW	R1, (g_sched+gobuf_sp)(R3)
+
+havem:
+	// Now there's a valid m, and we're running on its m->g0.
+	// Save current m->g0->sched.sp on stack and then set it to SP.
+	// Save current sp in m->g0->sched.sp in preparation for
+	// switch back to m->curg stack.
+	// NOTE: unwindm knows that the saved g->sched.sp is at 8(R1) aka savedsp-16(SP).
+	MOVW	m_g0(R8), R3
+	MOVW	(g_sched+gobuf_sp)(R3), R4
+	MOVW	R4, savedsp-16(SP)      // must match frame size
+	MOVW	R1, (g_sched+gobuf_sp)(R3)
+
+	// Switch to m->curg stack and call runtime.cgocallbackg.
+	// Because we are taking over the execution of m->curg
+	// but *not* resuming what had been running, we need to
+	// save that information (m->curg->sched) so we can restore it.
+	// We can restore m->curg->sched.sp easily, because calling
+	// runtime.cgocallbackg leaves SP unchanged upon return.
+	// To save m->curg->sched.pc, we push it onto the curg stack and
+	// open a frame the same size as cgocallback's g0 frame.
+	// Once we switch to the curg stack, the pushed PC will appear
+	// to be the return PC of cgocallback, so that the traceback
+	// will seamlessly trace back into the earlier calls.
+	MOVW	m_curg(R8), g
+	BL	runtime·save_g(SB)
+	MOVW	(g_sched+gobuf_sp)(g), R4 // prepare stack as R4
+	MOVW	(g_sched+gobuf_pc)(g), R5
+	MOVW	R5, -(16+FIXED_FRAME)(R4)	// "saved LR"; must match frame size
+	// Gather our arguments into registers.
+	MOVW	fn+0(FP), R5
+	MOVW	frame+4(FP), R6
+	MOVW	ctxt+8(FP), R7
+	MOVW	$-(16+FIXED_FRAME)(R4), R1	// switch stack; must match frame size
+	MOVW	R5, FIXED_FRAME+0(R1)
+	MOVW	R6, FIXED_FRAME+4(R1)
+	MOVW	R7, FIXED_FRAME+8(R1)
+
+	MOVW	$runtime·cgocallbackg(SB), R12
+	MOVW	R12, CTR
+	BL	(CTR)
+
+	// Restore g->sched (== m->curg->sched) from saved values.
+	MOVW	0(R1), R5
+	MOVW	R5, (g_sched+gobuf_pc)(g)
+	MOVW	$(16+FIXED_FRAME)(R1), R4	// must match frame size
+	MOVW	R4, (g_sched+gobuf_sp)(g)
+
+	// Switch back to m->g0's stack and restore m->g0->sched.sp.
+	// (Unlike m->curg, the g0 goroutine never uses sched.pc,
+	// so we do not have to restore it.)
+	MOVW	g_m(g), R8
+	MOVW	m_g0(R8), g
+	BL	runtime·save_g(SB)
+	MOVW	(g_sched+gobuf_sp)(g), R1
+	MOVW	savedsp-16(SP), R4	// must match frame size
+	MOVW	R4, (g_sched+gobuf_sp)(g)
+
+	// If the m on entry was nil, we called needm above to borrow an m,
+	// 1. for the duration of the call on non-pthread platforms,
+	// 2. or the duration of the C thread alive on pthread platforms.
+	// If the m on entry wasn't nil,
+	// 1. the thread might be a Go thread,
+	// 2. or it wasn't the first call from a C thread on pthread platforms,
+	//    since then we skip dropm to reuse the m in the first call.
+	MOVW	savedm-4(SP), R6
+	CMPW	R6, $0
+	BNE	droppedm
+
+	// Skip dropm to reuse it in the next call, when a pthread key has been created.
+	MOVW	_cgo_pthread_key_created(SB), R6
+	// It means cgo is disabled when _cgo_pthread_key_created is a nil pointer, need dropm.
+	CMPW	R6, $0
+	BEQ	dropm
+	MOVW	(R6), R6
+	CMPW	R6, $0
+	BNE	droppedm
+
+dropm:
+	MOVW	$runtime·dropm(SB), R12
+	MOVW	R12, CTR
+	BL	(CTR)
+droppedm:
+
+	// Done!
+	RET
+
+// void setg(G*); set g. for use by needm.
+TEXT runtime·setg(SB), NOSPLIT, $0-4
+	MOVW	gg+0(FP), g
+	// This only happens if iscgo, so jump straight to save_g
+	BL	runtime·save_g(SB)
+	RET
+
+// void setg_gcc(G*); set g in C TLS.
+// Must obey the gcc calling convention.
+TEXT setg_gcc<>(SB),NOSPLIT|NOFRAME,$0-0
+	// The standard prologue clobbers R31, which is callee-save in
+	// the C ABI, so we have to use NOFRAME and save LR ourselves.
+	MOVW	LR, R4
+	// Also save g and R31, since they're callee-save in C ABI
+	MOVW	R31, R5
+	MOVW	g, R6
+
+	MOVW	R3, g
+	BL	runtime·save_g(SB)
+
+	MOVW	R6, g
+	MOVW	R5, R31
+	MOVW	R4, LR
+	RET
+
+TEXT runtime·abort(SB),NOSPLIT|NOFRAME,$0-0
+	MOVW	(R0), R0
+	UNDEF
+
+#define TBL	268
+#define TBU	269
+
+// int64 runtime·cputicks(void)
+TEXT runtime·cputicks(SB),NOSPLIT,$0-8
+retry:
+	MOVW	SPR(TBU), R4
+	MOVW	SPR(TBL), R5
+	MOVW	SPR(TBU), R6
+	CMPW	R4, R6
+	BNE	retry
+	MOVW	R4, ret+0(FP)	// high word first (big endian)
+	MOVW	R5, ret+4(FP)
+	RET
+
+// Called from cgo wrappers, this function returns g->m->curg.stack.hi.
+// Must obey the gcc calling convention.
+TEXT _cgo_topofstack(SB),NOSPLIT|NOFRAME,$0
+	// g (R30) and R31 are callee-save in the C ABI, so save them
+	MOVW	g, R4
+	MOVW	R31, R5
+	MOVW	LR, R6
+
+	BL	runtime·load_g(SB)	// clobbers g (R30), R31
+	MOVW	g_m(g), R3
+	MOVW	m_curg(R3), R3
+	MOVW	(g_stack+stack_hi)(R3), R3
+
+	MOVW	R4, g
+	MOVW	R5, R31
+	MOVW	R6, LR
+	RET
+
+// The top-most function running on a goroutine
+// returns to goexit+PCQuantum.
+TEXT runtime·goexit(SB),NOSPLIT|NOFRAME|TOPFRAME,$0-0
+	OR	R0, R0, R0	// NOP
+	BL	runtime·goexit1(SB)	// does not return
+	// traceback from goexit1 must hit code range of goexit
+	OR	R0, R0, R0	// NOP
+
+// gcWriteBarrier informs the GC about heap pointer writes.
+//
+// gcWriteBarrier does NOT follow the Go ABI. It accepts the
+// number of bytes of buffer needed in R29, and returns a pointer
+// to the buffer space in R29.
+// It clobbers condition codes.
+// It does not clobber any other general-purpose registers except R31,
+// but may clobber floating point registers... actually it does not.
+TEXT gcWriteBarrier<>(SB),NOSPLIT,$112
+	// The standard prologue clobbers R31.
+	// We use R18, R19, and R31 as scratch registers.
+	MOVW	R18, (FIXED_FRAME+0)(R1)
+	MOVW	R19, (FIXED_FRAME+4)(R1)
+retry:
+	MOVW	g_m(g), R18
+	MOVW	m_p(R18), R18
+	MOVW	(p_wbBuf+wbBuf_next)(R18), R19
+	MOVW	(p_wbBuf+wbBuf_end)(R18), R31
+	// Increment wbBuf.next position.
+	ADD	R29, R19
+	// Is the buffer full?
+	CMPWU	R31, R19
+	BLT	flush
+	// Commit to the larger buffer.
+	MOVW	R19, (p_wbBuf+wbBuf_next)(R18)
+	// Make return value (the original next position)
+	SUB	R29, R19, R29
+	MOVW	(FIXED_FRAME+0)(R1), R18
+	MOVW	(FIXED_FRAME+4)(R1), R19
+	RET
+
+flush:
+	// Save all general purpose registers since these could be
+	// clobbered by wbBufFlush and were not saved by the caller.
+	// R18, R19 already saved.
+	// R0 is always 0.
+	// R1 is SP.
+	// R2 is the TLS pointer, R13 the SDA pointer; neither is used by Go.
+	MOVW	R3, (FIXED_FRAME+8)(R1)
+	MOVW	R4, (FIXED_FRAME+12)(R1)
+	MOVW	R5, (FIXED_FRAME+16)(R1)
+	MOVW	R6, (FIXED_FRAME+20)(R1)
+	MOVW	R7, (FIXED_FRAME+24)(R1)
+	MOVW	R8, (FIXED_FRAME+28)(R1)
+	MOVW	R9, (FIXED_FRAME+32)(R1)
+	MOVW	R10, (FIXED_FRAME+36)(R1)
+	MOVW	R11, (FIXED_FRAME+40)(R1)
+	MOVW	R12, (FIXED_FRAME+44)(R1)
+	MOVW	R14, (FIXED_FRAME+48)(R1)
+	MOVW	R15, (FIXED_FRAME+52)(R1)
+	MOVW	R16, (FIXED_FRAME+56)(R1)
+	MOVW	R17, (FIXED_FRAME+60)(R1)
+	MOVW	R20, (FIXED_FRAME+64)(R1)
+	MOVW	R21, (FIXED_FRAME+68)(R1)
+	MOVW	R22, (FIXED_FRAME+72)(R1)
+	MOVW	R23, (FIXED_FRAME+76)(R1)
+	MOVW	R24, (FIXED_FRAME+80)(R1)
+	MOVW	R25, (FIXED_FRAME+84)(R1)
+	MOVW	R26, (FIXED_FRAME+88)(R1)
+	MOVW	R27, (FIXED_FRAME+92)(R1)
+	MOVW	R28, (FIXED_FRAME+96)(R1)
+	MOVW	R29, (FIXED_FRAME+100)(R1)
+	// R30 is g.
+	// R31 is a scratch register, already clobbered.
+
+	BL	runtime·wbBufFlush(SB)
+
+	MOVW	(FIXED_FRAME+8)(R1), R3
+	MOVW	(FIXED_FRAME+12)(R1), R4
+	MOVW	(FIXED_FRAME+16)(R1), R5
+	MOVW	(FIXED_FRAME+20)(R1), R6
+	MOVW	(FIXED_FRAME+24)(R1), R7
+	MOVW	(FIXED_FRAME+28)(R1), R8
+	MOVW	(FIXED_FRAME+32)(R1), R9
+	MOVW	(FIXED_FRAME+36)(R1), R10
+	MOVW	(FIXED_FRAME+40)(R1), R11
+	MOVW	(FIXED_FRAME+44)(R1), R12
+	MOVW	(FIXED_FRAME+48)(R1), R14
+	MOVW	(FIXED_FRAME+52)(R1), R15
+	MOVW	(FIXED_FRAME+56)(R1), R16
+	MOVW	(FIXED_FRAME+60)(R1), R17
+	MOVW	(FIXED_FRAME+64)(R1), R20
+	MOVW	(FIXED_FRAME+68)(R1), R21
+	MOVW	(FIXED_FRAME+72)(R1), R22
+	MOVW	(FIXED_FRAME+76)(R1), R23
+	MOVW	(FIXED_FRAME+80)(R1), R24
+	MOVW	(FIXED_FRAME+84)(R1), R25
+	MOVW	(FIXED_FRAME+88)(R1), R26
+	MOVW	(FIXED_FRAME+92)(R1), R27
+	MOVW	(FIXED_FRAME+96)(R1), R28
+	MOVW	(FIXED_FRAME+100)(R1), R29
+	BR	retry
+
+TEXT runtime·gcWriteBarrier1<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	$4, R29
+	BR	gcWriteBarrier<>(SB)
+TEXT runtime·gcWriteBarrier2<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	$8, R29
+	BR	gcWriteBarrier<>(SB)
+TEXT runtime·gcWriteBarrier3<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	$12, R29
+	BR	gcWriteBarrier<>(SB)
+TEXT runtime·gcWriteBarrier4<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	$16, R29
+	BR	gcWriteBarrier<>(SB)
+TEXT runtime·gcWriteBarrier5<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	$20, R29
+	BR	gcWriteBarrier<>(SB)
+TEXT runtime·gcWriteBarrier6<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	$24, R29
+	BR	gcWriteBarrier<>(SB)
+TEXT runtime·gcWriteBarrier7<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	$28, R29
+	BR	gcWriteBarrier<>(SB)
+TEXT runtime·gcWriteBarrier8<ABIInternal>(SB),NOSPLIT,$0
+	MOVW	$32, R29
+	BR	gcWriteBarrier<>(SB)
+
+TEXT runtime·panicBounds<ABIInternal>(SB),NOSPLIT,$72-0
+	NO_LOCAL_POINTERS
+	// Save all 16 int registers that could have an index in them.
+	// They may be pointers, but if so they are dead.
+	// Skip R0 aka ZERO, R1 aka SP, R2 aka SB. R3-R18 are saved
+	// at 16(R1)..76(R1); the index registers are R3-R9 (and R14-R18
+	// are never used as such, but the save area is a [16]int32).
+	MOVW	R3, 16(R1)
+	MOVW	R4, 20(R1)
+	MOVW	R5, 24(R1)
+	MOVW	R6, 28(R1)
+	MOVW	R7, 32(R1)
+	MOVW	R8, 36(R1)
+	MOVW	R9, 40(R1)
+	MOVW	R10, 44(R1)
+	MOVW	R11, 48(R1)
+	MOVW	R12, 52(R1)
+	MOVW	R13, 56(R1)
+	MOVW	R14, 60(R1)
+	MOVW	R15, 64(R1)
+	MOVW	R16, 68(R1)
+	MOVW	R17, 72(R1)
+	MOVW	R18, 76(R1)
+
+	MOVW	LR, R3		// PC immediately after call to panicBounds
+	MOVW	R3, 8(R1)
+	ADD	$16, R1, R4	// pointer to save area
+	MOVW	R4, 12(R1)
+	BL	runtime·panicBounds32<ABIInternal>(SB)
+	RET
+
+TEXT runtime·panicExtend<ABIInternal>(SB),NOSPLIT,$72-0
+	NO_LOCAL_POINTERS
+	MOVW	R3, 16(R1)
+	MOVW	R4, 20(R1)
+	MOVW	R5, 24(R1)
+	MOVW	R6, 28(R1)
+	MOVW	R7, 32(R1)
+	MOVW	R8, 36(R1)
+	MOVW	R9, 40(R1)
+	MOVW	R10, 44(R1)
+	MOVW	R11, 48(R1)
+	MOVW	R12, 52(R1)
+	MOVW	R13, 56(R1)
+	MOVW	R14, 60(R1)
+	MOVW	R15, 64(R1)
+	MOVW	R16, 68(R1)
+	MOVW	R17, 72(R1)
+	MOVW	R18, 76(R1)
+
+	MOVW	LR, R3		// PC immediately after call to panicExtend
+	MOVW	R3, 8(R1)
+	ADD	$16, R1, R4	// pointer to save area
+	MOVW	R4, 12(R1)
+	BL	runtime·panicBounds32X<ABIInternal>(SB)
+	RET
