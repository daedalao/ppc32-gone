+		ssagen.AddAux(&p.From, v)
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = ppc64.REGTMP
+		if logopt.Enabled() {
+			logopt.LogOpt(v.Pos, "nilcheck", "genssa", v.Block.Func.Name)
+		}
+		if base.Debug.Nil != 0 && v.Pos.Line() > 1 { // v.Pos.Line()==1 in generated wrappers
+			base.WarnfAt(v.Pos, "generated nil check")
+		}
+
+	case ssaop.OpPPCInvertFlags:
+		v.Fatalf("InvertFlags should never make it to codegen %v", v.LongString())
+	case ssaop.OpPPCFlagEQ, ssaop.OpPPCFlagLT, ssaop.OpPPCFlagGT:
+		v.Fatalf("Flag* ops should never make it to codegen %v", v.LongString())
+	case ssaop.OpClobber, ssaop.OpClobberReg:
+		// TODO: implement for clobberdead experiment. Nop is ok for now.
+	default:
+		v.Fatalf("genValue not implemented: %s", v.LongString())
+	}
+}
+
+var blockJump = [...]struct {
+	asm, invasm     obj.As
+	asmeq, invasmun bool
+}{
+	block.BlockPPCEQ: {ppc64.ABEQ, ppc64.ABNE, false, false},
+	block.BlockPPCNE: {ppc64.ABNE, ppc64.ABEQ, false, false},
+
+	block.BlockPPCLT: {ppc64.ABLT, ppc64.ABGE, false, false},
+	block.BlockPPCGE: {ppc64.ABGE, ppc64.ABLT, false, false},
+	block.BlockPPCLE: {ppc64.ABLE, ppc64.ABGT, false, false},
+	block.BlockPPCGT: {ppc64.ABGT, ppc64.ABLE, false, false},
+
+	// TODO: need to work FP comparisons into block jumps
+	block.BlockPPCFLT: {ppc64.ABLT, ppc64.ABGE, false, false},
+	block.BlockPPCFGE: {ppc64.ABGT, ppc64.ABLT, true, true}, // GE = GT or EQ; !GE = LT or UN
+	block.BlockPPCFLE: {ppc64.ABLT, ppc64.ABGT, true, true}, // LE = LT or EQ; !LE = GT or UN
+	block.BlockPPCFGT: {ppc64.ABGT, ppc64.ABLE, false, false},
+}
+
+func ssaGenBlock(s *ssagen.State, b, next *ssa.Block) {
+	switch b.Kind {
+	case block.BlockPlain, block.BlockDefer:
+		if b.Succs[0].Block() != next {
+			p := s.Prog(obj.AJMP)
+			p.To.Type = obj.TYPE_BRANCH
+			s.Branches = append(s.Branches, ssagen.Branch{P: p, B: b.Succs[0].Block()})
+		}
+	case block.BlockExit, block.BlockRetJmp:
+	case block.BlockRet:
+		s.Prog(obj.ARET)
+
+	case block.BlockPPCEQ, block.BlockPPCNE,
+		block.BlockPPCLT, block.BlockPPCGE,
+		block.BlockPPCLE, block.BlockPPCGT,
+		block.BlockPPCFLT, block.BlockPPCFGE,
+		block.BlockPPCFLE, block.BlockPPCFGT:
+		jmp := blockJump[b.Kind]
+		switch next {
+		case b.Succs[0].Block():
+			s.Br(jmp.invasm, b.Succs[1].Block())
+			if jmp.invasmun {
+				// TODO: The second branch is probably predict-not-taken since it is for FP unordered
+				s.Br(ppc64.ABVS, b.Succs[1].Block())
+			}
+		case b.Succs[1].Block():
+			s.Br(jmp.asm, b.Succs[0].Block())
+			if jmp.asmeq {
+				s.Br(ppc64.ABEQ, b.Succs[0].Block())
+			}
+		default:
+			if b.Likely != ssa.BranchUnlikely {
+				s.Br(jmp.asm, b.Succs[0].Block())
+				if jmp.asmeq {
+					s.Br(ppc64.ABEQ, b.Succs[0].Block())
+				}
+				s.Br(obj.AJMP, b.Succs[1].Block())
+			} else {
+				s.Br(jmp.invasm, b.Succs[1].Block())
+				if jmp.invasmun {
+					// TODO: The second branch is probably predict-not-taken since it is for FP unordered
+					s.Br(ppc64.ABVS, b.Succs[1].Block())
+				}
+				s.Br(obj.AJMP, b.Succs[0].Block())
+			}
+		}
+	default:
+		b.Fatalf("branch not implemented: %s", b.LongString())
+	}
+}
diff --git a/src/cmd/compile/internal/ssa/_gen/PPC.rules b/src/cmd/compile/internal/ssa/_gen/PPC.rules
new file mode 100644
index 0000000000..ec2d8a6469
--- /dev/null
+++ b/src/cmd/compile/internal/ssa/_gen/PPC.rules
@@ -0,0 +1,691 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Lowering rules for 32-bit PowerPC (GOARCH=ppc). The target is the
+// classic 32-bit PowerPC ISA (G3/G4 class cores), so nothing newer than
+// ISA 2.02 is used: no isel, no popcnt, no fcfid, no lwsync.
+
+(Add(Ptr|32|16|8) ...) => (ADD ...)
+(Add32F ...) => (FADDS ...)
+(Add64F ...) => (FADD ...)
+
+(Sub(Ptr|32|16|8) ...) => (SUB ...)
+(Sub32F ...) => (FSUBS ...)
+(Sub64F ...) => (FSUB ...)
+
+(Mul(32|16|8) ...) => (MULLW ...)
+(Mul32F ...) => (FMULS ...)
+(Mul64F ...) => (FMUL ...)
+
+(Div32F ...) => (FDIVS ...)
+(Div64F ...) => (FDIV ...)
+
+(Hmul32 ...) => (MULHW ...)
+(Hmul32u ...) => (MULHWU ...)
+(Select0 (Mul32uhilo x y)) => (MULHWU x y)
+(Select1 (Mul32uhilo x y)) => (MULLW x y)
+
+(Div32 x y) => (DIVW x y)
+(Div32u ...) => (DIVWU ...)
+(Div16 x y) => (DIVW (SignExt16to32 x) (SignExt16to32 y))
+(Div16u x y) => (DIVWU (ZeroExt16to32 x) (ZeroExt16to32 y))
+(Div8 x y) => (DIVW (SignExt8to32 x) (SignExt8to32 y))
+(Div8u x y) => (DIVWU (ZeroExt8to32 x) (ZeroExt8to32 y))
+
+(Mod32 x y) => (SUB x (MULLW y (DIVW x y)))
+(Mod32u x y) => (SUB x (MULLW y (DIVWU x y)))
+(Mod16 x y) => (Mod32 (SignExt16to32 x) (SignExt16to32 y))
+(Mod16u x y) => (Mod32u (ZeroExt16to32 x) (ZeroExt16to32 y))
+(Mod8 x y) => (Mod32 (SignExt8to32 x) (SignExt8to32 y))
+(Mod8u x y) => (Mod32u (ZeroExt8to32 x) (ZeroExt8to32 y))
+
+// (x + y) / 2 with x>=y => (x - y) / 2 + y
+(Avg32u <t> x y) => (ADD (SRWconst <t> (SUB <t> x y) [1]) y)
+
+(And(32|16|8) ...) => (AND ...)
+(Or(32|16|8) ...) => (OR ...)
+(Xor(32|16|8) ...) => (XOR ...)
+
+(Neg(32|16|8) ...) => (NEG ...)
+(Neg(32|64)F ...) => (FNEG ...)
+
+(Com(32|16|8) x) => (NOR x x)
+
+// Lowering boolean ops
+(AndB ...) => (AND ...)
+(OrB ...) => (OR ...)
+(EqB x y) => (ANDconst [1] (EQV x y))
+(NeqB ...) => (XOR ...)
+(Not x) => (XORconst [1] x)
+
+// Merge logical operations
+(AND x (NOR y y)) => (ANDN x y)
+(OR x (NOR y y)) => (ORN x y)
+
+// Lowering constants
+(Const(32|16|8) [val]) => (MOVWconst [int32(val)])
+(Const32F ...) => (FMOVSconst ...)
+(Const64F ...) => (FMOVDconst ...)
+(ConstNil) => (MOVWconst [0])
+(ConstBool [t]) => (MOVWconst [ssa.B2i32(t)])
+
+// truncations
+// Because we ignore high parts of registers, truncates are just copies.
+(Trunc16to8 ...) => (Copy ...)
+(Trunc32to8 ...) => (Copy ...)
+(Trunc32to16 ...) => (Copy ...)
+
+// Zero-/Sign-extensions
+(ZeroExt8to(16|32) ...) => (MOVBZreg ...)
+(ZeroExt16to32 ...) => (MOVHZreg ...)
+(SignExt8to(16|32) ...) => (MOVBreg ...)
+(SignExt16to32 ...) => (MOVHreg ...)
+
+(Signmask x) => (SRAWconst x [31])
+(Zeromask x) => (SRAWconst (OR <typ.UInt32> x (NEG <typ.UInt32> x)) [31])
+(Slicemask <t> x) => (SRAWconst (NEG <t> x) [31])
+
+// Carrying addition and borrowing subtraction (used by dec64).
+// The carry/borrow flags value only ever flows between these ops,
+// so the PPC convention (CA set means "no borrow" for subtraction)
+// is preserved end to end.
+(Select0 (Add32carry x y)) => (Select0 <typ.UInt32> (ADDC x y))
+(Select1 (Add32carry x y)) => (Select1 <types.TypeFlags> (ADDC x y))
+(Add32withcarry ...) => (ADDE ...)
+(Select0 (Add32carrywithcarry x y c)) => (Select0 <typ.UInt32> (ADDEcarry x y c))
+(Select1 (Add32carrywithcarry x y c)) => (Select1 <types.TypeFlags> (ADDEcarry x y c))
+
+(Select0 (Sub32carry x y)) => (Select0 <typ.UInt32> (SUBC x y))
+(Select1 (Sub32carry x y)) => (Select1 <types.TypeFlags> (SUBC x y))
+(Sub32withcarry ...) => (SUBE ...)
+
+(ADDC x (MOVWconst [c])) && ssa.Is16Bit(int64(c)) => (ADDCconst [c] x)
+
+// Constant shifts.
+// generic opt rewrites all constant shifts to shift by Const64
+(Lsh32x64  x (Const64 [c])) && uint64(c) < 32 => (SLWconst x [int32(c)])
+(Rsh32x64  x (Const64 [c])) && uint64(c) < 32 => (SRAWconst x [int32(c)])
+(Rsh32Ux64 x (Const64 [c])) && uint64(c) < 32 => (SRWconst x [int32(c)])
+(Lsh16x64  x (Const64 [c])) && uint64(c) < 16 => (SLWconst x [int32(c)])
+(Rsh16x64  x (Const64 [c])) && uint64(c) < 16 => (SRAWconst (SignExt16to32 x) [int32(c)])
+(Rsh16Ux64 x (Const64 [c])) && uint64(c) < 16 => (SRWconst (ZeroExt16to32 x) [int32(c)])
+(Lsh8x64   x (Const64 [c])) && uint64(c) < 8  => (SLWconst x [int32(c)])
+(Rsh8x64   x (Const64 [c])) && uint64(c) < 8  => (SRAWconst (SignExt8to32 x) [int32(c)])
+(Rsh8Ux64  x (Const64 [c])) && uint64(c) < 8  => (SRWconst (ZeroExt8to32 x) [int32(c)])
+
+// large constant shifts
+(Lsh32x64  _ (Const64 [c])) && uint64(c) >= 32 => (MOVWconst [0])
+(Rsh32Ux64 _ (Const64 [c])) && uint64(c) >= 32 => (MOVWconst [0])
+(Lsh16x64  _ (Const64 [c])) && uint64(c) >= 16 => (MOVWconst [0])
+(Rsh16Ux64 _ (Const64 [c])) && uint64(c) >= 16 => (MOVWconst [0])
+(Lsh8x64   _ (Const64 [c])) && uint64(c) >= 8  => (MOVWconst [0])
+(Rsh8Ux64  _ (Const64 [c])) && uint64(c) >= 8  => (MOVWconst [0])
+
+// large constant signed right shift, we leave the sign bit
+(Rsh32x64 x (Const64 [c])) && uint64(c) >= 32 => (SRAWconst x [31])
+(Rsh16x64 x (Const64 [c])) && uint64(c) >= 16 => (SRAWconst (SignExt16to32 x) [31])
+(Rsh8x64  x (Const64 [c])) && uint64(c) >= 8  => (SRAWconst (SignExt8to32 x) [31])
+
+// Bounded shifts. The hardware uses the low 6 bits of the shift amount,
+// so any amount < 64 already behaves per Go semantics.
+(Lsh(32|16|8)x32 x y) && ssa.ShiftIsBounded(v) => (SLW x y)
+(Lsh(32|16|8)x16 x y) && ssa.ShiftIsBounded(v) => (SLW x (ZeroExt16to32 y))
+(Lsh(32|16|8)x8  x y) && ssa.ShiftIsBounded(v) => (SLW x (ZeroExt8to32 y))
+(Rsh32Ux32 x y) && ssa.ShiftIsBounded(v) => (SRW x y)
+(Rsh32Ux16 x y) && ssa.ShiftIsBounded(v) => (SRW x (ZeroExt16to32 y))
+(Rsh32Ux8  x y) && ssa.ShiftIsBounded(v) => (SRW x (ZeroExt8to32 y))
+(Rsh16Ux32 x y) && ssa.ShiftIsBounded(v) => (SRW (ZeroExt16to32 x) y)
+(Rsh16Ux16 x y) && ssa.ShiftIsBounded(v) => (SRW (ZeroExt16to32 x) (ZeroExt16to32 y))
+(Rsh16Ux8  x y) && ssa.ShiftIsBounded(v) => (SRW (ZeroExt16to32 x) (ZeroExt8to32 y))
+(Rsh8Ux32  x y) && ssa.ShiftIsBounded(v) => (SRW (ZeroExt8to32 x) y)
+(Rsh8Ux16  x y) && ssa.ShiftIsBounded(v) => (SRW (ZeroExt8to32 x) (ZeroExt16to32 y))
+(Rsh8Ux8   x y) && ssa.ShiftIsBounded(v) => (SRW (ZeroExt8to32 x) (ZeroExt8to32 y))
+(Rsh32x32 x y) && ssa.ShiftIsBounded(v) => (SRAW x y)
+(Rsh32x16 x y) && ssa.ShiftIsBounded(v) => (SRAW x (ZeroExt16to32 y))
+(Rsh32x8  x y) && ssa.ShiftIsBounded(v) => (SRAW x (ZeroExt8to32 y))
+(Rsh16x32 x y) && ssa.ShiftIsBounded(v) => (SRAW (SignExt16to32 x) y)
+(Rsh16x16 x y) && ssa.ShiftIsBounded(v) => (SRAW (SignExt16to32 x) (ZeroExt16to32 y))
+(Rsh16x8  x y) && ssa.ShiftIsBounded(v) => (SRAW (SignExt16to32 x) (ZeroExt8to32 y))
+(Rsh8x32  x y) && ssa.ShiftIsBounded(v) => (SRAW (SignExt8to32 x) y)
+(Rsh8x16  x y) && ssa.ShiftIsBounded(v) => (SRAW (SignExt8to32 x) (ZeroExt16to32 y))
+(Rsh8x8   x y) && ssa.ShiftIsBounded(v) => (SRAW (SignExt8to32 x) (ZeroExt8to32 y))
+
+// Unbounded shifts. Go shifts saturate to 0 or -1 when shifting beyond
+// the number of bits in a type. The hardware already does that for
+// amounts in 32..63; for larger amounts we force the amount to 63 via
+// the mask trick: y | ^mask, where mask is -1 if y < 32 and 0 otherwise.
+(Lsh(32|16|8)x32 x y) => (SLW x (ORN y (MaskIfNotCarry (ADDconstForCarry [-32] y))))
+(Lsh(32|16|8)x16 x y) => (SLW x (ORN (ZeroExt16to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt16to32 y)))))
+(Lsh(32|16|8)x8  x y) => (SLW x (ORN (ZeroExt8to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt8to32 y)))))
+(Rsh32Ux32 x y) => (SRW x (ORN y (MaskIfNotCarry (ADDconstForCarry [-32] y))))
+(Rsh32Ux16 x y) => (SRW x (ORN (ZeroExt16to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt16to32 y)))))
+(Rsh32Ux8  x y) => (SRW x (ORN (ZeroExt8to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt8to32 y)))))
+(Rsh16Ux32 x y) => (SRW (ZeroExt16to32 x) (ORN y (MaskIfNotCarry (ADDconstForCarry [-32] y))))
+(Rsh16Ux16 x y) => (SRW (ZeroExt16to32 x) (ORN (ZeroExt16to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt16to32 y)))))
+(Rsh16Ux8  x y) => (SRW (ZeroExt16to32 x) (ORN (ZeroExt8to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt8to32 y)))))
+(Rsh8Ux32  x y) => (SRW (ZeroExt8to32 x) (ORN y (MaskIfNotCarry (ADDconstForCarry [-32] y))))
+(Rsh8Ux16  x y) => (SRW (ZeroExt8to32 x) (ORN (ZeroExt16to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt16to32 y)))))
+(Rsh8Ux8   x y) => (SRW (ZeroExt8to32 x) (ORN (ZeroExt8to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt8to32 y)))))
+(Rsh32x32 x y) => (SRAW x (ORN y (MaskIfNotCarry (ADDconstForCarry [-32] y))))
+(Rsh32x16 x y) => (SRAW x (ORN (ZeroExt16to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt16to32 y)))))
+(Rsh32x8  x y) => (SRAW x (ORN (ZeroExt8to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt8to32 y)))))
+(Rsh16x32 x y) => (SRAW (SignExt16to32 x) (ORN y (MaskIfNotCarry (ADDconstForCarry [-32] y))))
+(Rsh16x16 x y) => (SRAW (SignExt16to32 x) (ORN (ZeroExt16to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt16to32 y)))))
+(Rsh16x8  x y) => (SRAW (SignExt16to32 x) (ORN (ZeroExt8to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt8to32 y)))))
+(Rsh8x32  x y) => (SRAW (SignExt8to32 x) (ORN y (MaskIfNotCarry (ADDconstForCarry [-32] y))))
+(Rsh8x16  x y) => (SRAW (SignExt8to32 x) (ORN (ZeroExt16to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt16to32 y)))))
+(Rsh8x8   x y) => (SRAW (SignExt8to32 x) (ORN (ZeroExt8to32 y) (MaskIfNotCarry (ADDconstForCarry [-32] (ZeroExt8to32 y)))))
+
+// rotates
+(RotateLeft8  <t> x (MOVWconst [c])) => (Or8  (Lsh8x32 <t>  x (MOVWconst [c&7]))  (Rsh8Ux32 <t> x (MOVWconst [-c&7])))
+(RotateLeft16 <t> x (MOVWconst [c])) => (Or16 (Lsh16x32 <t> x (MOVWconst [c&15])) (Rsh16Ux32 <t> x (MOVWconst [-c&15])))
+(RotateLeft32 ...) => (ROTLW ...)
+(RotateLeft64 <t> x (MOVWconst [c])) => (Or64 (Lsh64x32 <t> x (MOVWconst [c&63])) (Rsh64Ux32 <t> x (MOVWconst [-c&63])))
+(ROTLW x (MOVWconst [c])) => (ROTLWconst x [c&31])
+
+// count trailing zero: 32 - CLZ(x&-x - 1)
+(Ctz(32|16|8)NonZero ...) => (Ctz32 ...)
+(Ctz32 <t> x) => (SUBFCconst [32] (CNTLZW <t> (ADDconst <t> [-1] (AND <t> x (NEG <t> x)))))
+(Ctz16 x) => (Ctz32 (OR <typ.UInt32> x (MOVWconst [1<<16])))
+(Ctz8  x) => (Ctz32 (OR <typ.UInt32> x (MOVWconst [1<<8])))
+
+// bit length
+(BitLen32 <t> x) => (SUBFCconst [32] (CNTLZW <t> x))
+(BitLen(16|8) x) => (BitLen32 (ZeroExt(16|8)to32 x))
+
+// float-int conversion
+(Cvt32to64F ...) => (LoweredCvt32to64F ...)
+(Cvt32to32F x) => (FRSP (LoweredCvt32to64F x))
+(Cvt(32|64)Fto32 x) => (LoweredFPtoGP (FCTIWZ x))
+(Cvt32Fto64F ...) => (Copy ...) // Note v will have the wrong type for patterns dependent on Float32/Float64
+(Cvt64Fto32F ...) => (FRSP ...)
+(CvtBoolToUint8 ...) => (Copy ...)
+(Round(32|64)F ...) => (Copy ...)
+
+// comparisons
+(Eq(8|16) x y) => (Equal (CMPW (ZeroExt(8|16)to32 x) (ZeroExt(8|16)to32 y)))
+(Eq(32|Ptr) x y) => (Equal (CMPW x y))
+(Eq(32|64)F x y) => (Equal (FCMPU x y))
+
+(Neq(8|16) x y) => (NotEqual (CMPW (ZeroExt(8|16)to32 x) (ZeroExt(8|16)to32 y)))
+(Neq(32|Ptr) x y) => (NotEqual (CMPW x y))
+(Neq(32|64)F x y) => (NotEqual (FCMPU x y))
+
+(Less(8|16) x y) => (LessThan (CMPW (SignExt(8|16)to32 x) (SignExt(8|16)to32 y)))
+(Less32 x y) => (LessThan (CMPW x y))
+(Less(32|64)F x y) => (FLessThan (FCMPU x y))
+
+(Less(8|16)U x y) => (LessThan (CMPWU (ZeroExt(8|16)to32 x) (ZeroExt(8|16)to32 y)))
+(Less32U x y) => (LessThan (CMPWU x y))
+
+(Leq(8|16) x y) => (LessEqual (CMPW (SignExt(8|16)to32 x) (SignExt(8|16)to32 y)))
+(Leq32 x y) => (LessEqual (CMPW x y))
+(Leq(32|64)F x y) => (FLessEqual (FCMPU x y))
+
+(Leq(8|16)U x y) => (LessEqual (CMPWU (ZeroExt(8|16)to32 x) (ZeroExt(8|16)to32 y)))
+(Leq32U x y) => (LessEqual (CMPWU x y))
+
+// Absorb pseudo-ops into blocks.
+(If (Equal cc) yes no) => (EQ cc yes no)
+(If (NotEqual cc) yes no) => (NE cc yes no)
+(If (LessThan cc) yes no) => (LT cc yes no)
+(If (LessEqual cc) yes no) => (LE cc yes no)
+(If (GreaterThan cc) yes no) => (GT cc yes no)
+(If (GreaterEqual cc) yes no) => (GE cc yes no)
+(If (FLessThan cc) yes no) => (FLT cc yes no)
+(If (FLessEqual cc) yes no) => (FLE cc yes no)
+(If (FGreaterThan cc) yes no) => (FGT cc yes no)
+(If (FGreaterEqual cc) yes no) => (FGE cc yes no)
+
+(If cond yes no) => (NE (CMPWconst [0] (ANDconst [1] cond)) yes no)
+
+// Absorb boolean tests into block
+(NE (CMPWconst [0] (ANDconst [1] ((Equal|NotEqual|LessThan|LessEqual|GreaterThan|GreaterEqual) cc))) yes no) => ((EQ|NE|LT|LE|GT|GE) cc yes no)
+(NE (CMPWconst [0] (ANDconst [1] ((FLessThan|FLessEqual|FGreaterThan|FGreaterEqual) cc))) yes no) => ((FLT|FLE|FGT|FGE) cc yes no)
+
+// absorb flag constants into branches
+(EQ (FlagEQ) yes no) => (First yes no)
+(EQ (FlagLT) yes no) => (First no yes)
+(EQ (FlagGT) yes no) => (First no yes)
+
+(NE (FlagEQ) yes no) => (First no yes)
+(NE (FlagLT) yes no) => (First yes no)
+(NE (FlagGT) yes no) => (First yes no)
+
+(LT (FlagEQ) yes no) => (First no yes)
+(LT (FlagLT) yes no) => (First yes no)
+(LT (FlagGT) yes no) => (First no yes)
+
+(LE (FlagEQ) yes no) => (First yes no)
+(LE (FlagLT) yes no) => (First yes no)
+(LE (FlagGT) yes no) => (First no yes)
+
+(GT (FlagEQ) yes no) => (First no yes)
+(GT (FlagLT) yes no) => (First no yes)
+(GT (FlagGT) yes no) => (First yes no)
+
+(GE (FlagEQ) yes no) => (First yes no)
+(GE (FlagLT) yes no) => (First no yes)
+(GE (FlagGT) yes no) => (First yes no)
+
+// absorb InvertFlags into branches
+(LT (InvertFlags cmp) yes no) => (GT cmp yes no)
+(GT (InvertFlags cmp) yes no) => (LT cmp yes no)
+(LE (InvertFlags cmp) yes no) => (GE cmp yes no)
+(GE (InvertFlags cmp) yes no) => (LE cmp yes no)
+(EQ (InvertFlags cmp) yes no) => (EQ cmp yes no)
+(NE (InvertFlags cmp) yes no) => (NE cmp yes no)
+
+// constant comparisons
+(CMPWconst (MOVWconst [x]) [y]) && x==y => (FlagEQ)
+(CMPWconst (MOVWconst [x]) [y]) && x<y  => (FlagLT)
+(CMPWconst (MOVWconst [x]) [y]) && x>y  => (FlagGT)
+
+(CMPWUconst (MOVWconst [x]) [y]) && x==y  => (FlagEQ)
