diff --git a/src/runtime/tls_ppc.s b/src/runtime/tls_ppc.s
new file mode 100644
index 0000000000..735997b244
--- /dev/null
+++ b/src/runtime/tls_ppc.s
@@ -0,0 +1,50 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build ppc
+
+#include "go_asm.h"
+#include "go_tls.h"
+#include "funcdata.h"
+#include "textflag.h"
+
+// We have to resort to TLS variable to save g (R30).
+// We have to save g only when we are called from C code,
+// e.g. via a signal handler or a cgo callback. The C ABI
+// thread pointer lives in R2 on 32-bit PowerPC.
+//
+// If we're not using cgo, then there is no TLS setup and
+// we don't need to save g (the runtime only ever runs Go code).
+
+// save_g saves the g register into pthread-provided
+// thread-local memory, so that we can call externally compiled
+// ppc code that will overwrite this register.
+//
+// If !iscgo, this is a no-op.
+//
+// NOTE: setg_gcc<> assumes this clobbers only R31.
+TEXT runtime·save_g(SB),NOSPLIT|NOFRAME,$0-0
+	MOVBZ	runtime·iscgo(SB), R31
+	CMPW	R31, $0
+	BEQ	nocgo
+	MOVW	runtime·tls_g(SB), R31
+	MOVW	g, 0(R31)
+
+nocgo:
+	RET
+
+// load_g loads the g register from pthread-provided
+// thread-local memory, for use after calling externally compiled
+// ppc code that overwrote those registers.
+//
+// This is never called directly from C code (it doesn't have to
+// follow the C ABI), but it may be called from a C context, via
+// cgocallback, so it must not clobber any registers other than
+// g (R30) and R31.
+TEXT runtime·load_g(SB),NOSPLIT|NOFRAME,$0-0
+	MOVW	runtime·tls_g(SB), R31
+	MOVW	0(R31), g
+	RET
+
+GLOBL runtime·tls_g+0(SB), TLSBSS+DUPOK, $4
