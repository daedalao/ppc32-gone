+package ppc
+
+import (
+	"cmd/compile/internal/ssa"
+	"cmd/compile/internal/ssagen"
+	"cmd/internal/obj/ppc64"
+)
+
+func Init(arch *ssagen.ArchInfo) {
+	arch.LinkArch = &ppc64.Linkppc
+	arch.REGSP = ppc64.REGSP
+	arch.MAXWIDTH = (1 << 31) - 1
+
+	arch.ZeroRange = zerorange
+	arch.Ginsnop = ginsnop
+
+	arch.SSAMarkMoves = func(s *ssagen.State, b *ssa.Block) {}
+	arch.SSAGenValue = ssaGenValue
+	arch.SSAGenBlock = ssaGenBlock
+}
diff --git a/src/cmd/compile/internal/ppc/ggen.go b/src/cmd/compile/internal/ppc/ggen.go
new file mode 100644
index 0000000000..a0d2afb965
--- /dev/null
+++ b/src/cmd/compile/internal/ppc/ggen.go
@@ -0,0 +1,55 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package ppc
+
+import (
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/objw"
+	"cmd/compile/internal/types"
+	"cmd/internal/obj"
+	"cmd/internal/obj/ppc64"
+)
+
+func zerorange(pp *objw.Progs, p *obj.Prog, off, cnt int64, _ *uint32) *obj.Prog {
+	if cnt == 0 {
+		return p
+	}
+	if cnt%int64(types.PtrSize) != 0 {
+		panic("zeroed region not aligned")
+	}
+	if cnt <= int64(16*types.PtrSize) {
+		for i := int64(0); i < cnt; i += int64(types.PtrSize) {
+			p = pp.Append(p, ppc64.AMOVW, obj.TYPE_REG, ppc64.REGZERO, 0, obj.TYPE_MEM, ppc64.REGSP, base.Ctxt.Arch.FixedFrameSize+off+i)
+		}
+		return p
+	}
+	// Large region: loop storing words.
+	//	ADD	$(FixedFrameSize+off-4), SP, R20
+	//	MOVW	$cnt, R31
+	//	ADD	R31, R20, R21
+	// loop:
+	//	MOVWU	R0, 4(R20)
+	//	CMPW	R20, R21
+	//	BNE	loop
+	p = pp.Append(p, ppc64.AADD, obj.TYPE_CONST, 0, base.Ctxt.Arch.FixedFrameSize+off-4, obj.TYPE_REG, ppc64.REGRT1, 0)
+	p.Reg = ppc64.REGSP
+	p = pp.Append(p, ppc64.AMOVW, obj.TYPE_CONST, 0, cnt, obj.TYPE_REG, ppc64.REGTMP, 0)
+	p = pp.Append(p, ppc64.AADD, obj.TYPE_REG, ppc64.REGTMP, 0, obj.TYPE_REG, ppc64.REGRT2, 0)
+	p.Reg = ppc64.REGRT1
+	p = pp.Append(p, ppc64.AMOVWU, obj.TYPE_REG, ppc64.REGZERO, 0, obj.TYPE_MEM, ppc64.REGRT1, int64(types.PtrSize))
+	p1 := p
+	p = pp.Append(p, ppc64.ACMPW, obj.TYPE_REG, ppc64.REGRT1, 0, obj.TYPE_REG, ppc64.REGRT2, 0)
+	p = pp.Append(p, ppc64.ABNE, obj.TYPE_NONE, 0, 0, obj.TYPE_BRANCH, 0, 0)
+	p.To.SetTarget(p1)
+	return p
+}
+
+func ginsnop(pp *objw.Progs) *obj.Prog {
+	// Generate the preferred hardware nop: ori 0,0,0
+	p := pp.Prog(ppc64.AOR)
+	p.From = obj.Addr{Type: obj.TYPE_CONST, Offset: 0}
+	p.To = obj.Addr{Type: obj.TYPE_REG, Reg: ppc64.REG_R0}
+	return p
+}
diff --git a/src/cmd/compile/internal/ppc/ssa.go b/src/cmd/compile/internal/ppc/ssa.go
new file mode 100644
index 0000000000..afa9f9dac8
--- /dev/null
+++ b/src/cmd/compile/internal/ppc/ssa.go
@@ -0,0 +1,1267 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package ppc
+
+import (
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/ir"
+	"cmd/compile/internal/logopt"
+	"cmd/compile/internal/ssa"
+	"cmd/compile/internal/ssa/block"
+	"cmd/compile/internal/ssa/ssaop"
+	"cmd/compile/internal/ssagen"
+	"cmd/compile/internal/types"
+	"cmd/internal/obj"
+	"cmd/internal/obj/ppc64"
+	"internal/abi"
+	"math"
+)
+
+// loadByType returns the load instruction of the given type.
+func loadByType(t *types.Type) obj.As {
+	if t.IsFloat() {
+		switch t.Size() {
+		case 4:
+			return ppc64.AFMOVS
+		case 8:
+			return ppc64.AFMOVD
+		}
+	} else {
+		switch t.Size() {
+		case 1:
+			if t.IsSigned() {
+				return ppc64.AMOVB
+			} else {
+				return ppc64.AMOVBZ
+			}
+		case 2:
+			if t.IsSigned() {
+				return ppc64.AMOVH
+			} else {
+				return ppc64.AMOVHZ
+			}
+		case 4:
+			return ppc64.AMOVW
+		}
+	}
+	panic("bad load type")
+}
+
+// storeByType returns the store instruction of the given type.
+func storeByType(t *types.Type) obj.As {
+	if t.IsFloat() {
+		switch t.Size() {
+		case 4:
+			return ppc64.AFMOVS
+		case 8:
+			return ppc64.AFMOVD
+		}
+	} else {
+		switch t.Size() {
+		case 1:
+			return ppc64.AMOVB
+		case 2:
+			return ppc64.AMOVH
+		case 4:
+			return ppc64.AMOVW
+		}
+	}
+	panic("bad store type")
+}
+
+// rlwinm emits RLWINM $sh, rs, $mb, $me, rt.
+func rlwinm(s *ssagen.State, rt, rs int16, sh, mb, me int64) *obj.Prog {
+	p := s.Prog(ppc64.ARLWNM)
+	p.From = obj.Addr{Type: obj.TYPE_CONST, Offset: sh}
+	p.Reg = rs
+	p.AddRestSourceArgs([]obj.Addr{{Type: obj.TYPE_CONST, Offset: mb}, {Type: obj.TYPE_CONST, Offset: me}})
+	p.To = obj.Addr{Type: obj.TYPE_REG, Reg: rt}
+	return p
+}
+
+// mfcr emits MOVW CR, rt.
+func mfcr(s *ssagen.State, rt int16) *obj.Prog {
+	p := s.Prog(ppc64.AMOVW)
+	p.From = obj.Addr{Type: obj.TYPE_REG, Reg: ppc64.REG_CR}
+	p.To = obj.Addr{Type: obj.TYPE_REG, Reg: rt}
+	return p
+}
+
+// Condition register bit positions in CR0.
+const (
+	crLT = 0
+	crGT = 1
+	crEQ = 2
+	crSO = 3 // unordered for FP compares
+)
+
+// genCRBit materializes bit crbit of CR0 (0 or 1) into rt.
+// If invert is set the result is complemented.
+func genCRBit(s *ssagen.State, rt int16, crbit int64, invert bool) {
+	mfcr(s, rt)
+	rlwinm(s, rt, rt, crbit+1, 31, 31)
+	if invert {
+		p := s.Prog(ppc64.AXOR)
+		p.From = obj.Addr{Type: obj.TYPE_CONST, Offset: 1}
+		p.Reg = rt
+		p.To = obj.Addr{Type: obj.TYPE_REG, Reg: rt}
+	}
+}
+
+// genCRBitOr materializes (CR0[bitA] | CR0[bitB]) into rt, using R31.
+func genCRBitOr(s *ssagen.State, rt int16, bitA, bitB int64) {
+	mfcr(s, rt)
+	rlwinm(s, ppc64.REGTMP, rt, bitA+1, 31, 31)
+	rlwinm(s, rt, rt, bitB+1, 31, 31)
+	p := s.Prog(ppc64.AOR)
+	p.From = obj.Addr{Type: obj.TYPE_REG, Reg: ppc64.REGTMP}
+	p.Reg = rt
+	p.To = obj.Addr{Type: obj.TYPE_REG, Reg: rt}
+}
+
+func ssaGenValue(s *ssagen.State, v *ssa.Value) {
+	switch v.Op {
+	case ssaop.OpCopy:
+		t := v.Type
+		if t.IsMemory() {
+			return
+		}
+		x := v.Args[0].Reg()
+		y := v.Reg()
+		if x != y {
+			rt := obj.TYPE_REG
+			op := ppc64.AMOVW
+
+			if t.IsFloat() {
+				op = ppc64.AFMOVD
+			}
+			p := s.Prog(op)
+			p.From.Type = rt
+			p.From.Reg = x
+			p.To.Type = rt
+			p.To.Reg = y
+		}
+
+	case ssaop.OpPPCLoweredAtomicAnd8,
+		ssaop.OpPPCLoweredAtomicAnd32,
+		ssaop.OpPPCLoweredAtomicOr8,
+		ssaop.OpPPCLoweredAtomicOr32:
+		// SYNC
+		// LBAR/LWAR	(Rarg0), Rtmp
+		// AND/OR	Rarg1, Rtmp
+		// STBCCC/STWCCC Rtmp, (Rarg0)
+		// BNE		-3(PC)
+		// ISYNC
+		ld := ppc64.ALBAR
+		st := ppc64.ASTBCCC
+		if v.Op == ssaop.OpPPCLoweredAtomicAnd32 || v.Op == ssaop.OpPPCLoweredAtomicOr32 {
+			ld = ppc64.ALWAR
+			st = ppc64.ASTWCCC
+		}
+		r0 := v.Args[0].Reg()
+		r1 := v.Args[1].Reg()
+		s.Prog(ppc64.ASYNC)
+		p := s.Prog(ld)
+		p.From.Type = obj.TYPE_MEM
+		p.From.Reg = r0
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = ppc64.REGTMP
+		p1 := s.Prog(v.Op.Asm())
+		p1.From.Type = obj.TYPE_REG
+		p1.From.Reg = r1
+		p1.To.Type = obj.TYPE_REG
+		p1.To.Reg = ppc64.REGTMP
+		p2 := s.Prog(st)
+		p2.From.Type = obj.TYPE_REG
+		p2.From.Reg = ppc64.REGTMP
+		p2.To.Type = obj.TYPE_MEM
+		p2.To.Reg = r0
+		p2.RegTo2 = ppc64.REGTMP
+		p3 := s.Prog(ppc64.ABNE)
+		p3.To.Type = obj.TYPE_BRANCH
+		p3.To.SetTarget(p)
+		s.Prog(ppc64.AISYNC)
+
+	case ssaop.OpPPCLoweredAtomicAdd32:
+		// SYNC
+		// LWAR		(Rarg0), Rout
+		// ADD		Rarg1, Rout
+		// STWCCC	Rout, (Rarg0)
+		// BNE		-3(PC)
+		// ISYNC
+		r0 := v.Args[0].Reg()
+		r1 := v.Args[1].Reg()
+		out := v.Reg0()
+		s.Prog(ppc64.ASYNC)
+		p := s.Prog(ppc64.ALWAR)
+		p.From.Type = obj.TYPE_MEM
+		p.From.Reg = r0
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = out
+		p1 := s.Prog(ppc64.AADD)
+		p1.From.Type = obj.TYPE_REG
+		p1.From.Reg = r1
+		p1.To.Reg = out
+		p1.To.Type = obj.TYPE_REG
+		p3 := s.Prog(ppc64.ASTWCCC)
+		p3.From.Type = obj.TYPE_REG
+		p3.From.Reg = out
+		p3.To.Type = obj.TYPE_MEM
+		p3.To.Reg = r0
+		p4 := s.Prog(ppc64.ABNE)
+		p4.To.Type = obj.TYPE_BRANCH
+		p4.To.SetTarget(p)
+		s.Prog(ppc64.AISYNC)
+
+	case ssaop.OpPPCLoweredAtomicExchange8,
+		ssaop.OpPPCLoweredAtomicExchange32:
+		// SYNC
+		// LWAR/LBAR	(Rarg0), Rout
+		// STWCCC/STBCCC Rarg1, (Rarg0)
+		// BNE		-2(PC)
+		// ISYNC
+		ld := ppc64.ALWAR
+		st := ppc64.ASTWCCC
+		if v.Op == ssaop.OpPPCLoweredAtomicExchange8 {
+			ld = ppc64.ALBAR
+			st = ppc64.ASTBCCC
+		}
+		r0 := v.Args[0].Reg()
+		r1 := v.Args[1].Reg()
+		out := v.Reg0()
+		s.Prog(ppc64.ASYNC)
+		p := s.Prog(ld)
+		p.From.Type = obj.TYPE_MEM
+		p.From.Reg = r0
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = out
+		p1 := s.Prog(st)
+		p1.From.Type = obj.TYPE_REG
+		p1.From.Reg = r1
+		p1.To.Type = obj.TYPE_MEM
+		p1.To.Reg = r0
+		p2 := s.Prog(ppc64.ABNE)
+		p2.To.Type = obj.TYPE_BRANCH
+		p2.To.SetTarget(p)
+		s.Prog(ppc64.AISYNC)
+
+	case ssaop.OpPPCLoweredAtomicLoad8,
+		ssaop.OpPPCLoweredAtomicLoad32,
+		ssaop.OpPPCLoweredAtomicLoadPtr:
+		// SYNC
+		// MOVB/MOVW (Rarg0), Rout
+		// CMPW Rout,Rout
+		// BNE 1(PC)
+		// ISYNC
+		ld := ppc64.AMOVW
+		if v.Op == ssaop.OpPPCLoweredAtomicLoad8 {
+			ld = ppc64.AMOVBZ
+		}
+		arg0 := v.Args[0].Reg()
+		out := v.Reg0()
+		// SYNC when AuxInt == 1; otherwise, load-acquire
+		if v.AuxInt == 1 {
+			s.Prog(ppc64.ASYNC)
+		}
+		p := s.Prog(ld)
+		p.From.Type = obj.TYPE_MEM
+		p.From.Reg = arg0
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = out
+		p1 := s.Prog(ppc64.ACMPW)
+		p1.From.Type = obj.TYPE_REG
+		p1.From.Reg = out
+		p1.To.Type = obj.TYPE_REG
+		p1.To.Reg = out
+		p2 := s.Prog(ppc64.ABNE)
+		p2.To.Type = obj.TYPE_BRANCH
+		pisync := s.Prog(ppc64.AISYNC)
+		p2.To.SetTarget(pisync)
+
+	case ssaop.OpPPCLoweredAtomicStore8,
+		ssaop.OpPPCLoweredAtomicStore32:
+		// SYNC
+		// MOVB/MOVW arg1,(arg0)
+		st := ppc64.AMOVW
+		if v.Op == ssaop.OpPPCLoweredAtomicStore8 {
+			st = ppc64.AMOVB
+		}
+		arg0 := v.Args[0].Reg()
+		arg1 := v.Args[1].Reg()
+		s.Prog(ppc64.ASYNC)
+		p := s.Prog(st)
+		p.To.Type = obj.TYPE_MEM
+		p.To.Reg = arg0
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = arg1
+
+	case ssaop.OpPPCLoweredAtomicCas32:
+		// MOVW        $0, Rout
+		// SYNC
+		// loop:
+		// LWAR        (Rarg0), Rtmp
+		// CMPW        Rarg1, Rtmp
+		// BNE         end
+		// STWCCC      Rarg2, (Rarg0)
+		// BNE         loop
+		// MOVW        $1, Rout
+		// end:
+		// ISYNC
+		r0 := v.Args[0].Reg()
+		r1 := v.Args[1].Reg()
+		r2 := v.Args[2].Reg()
+		out := v.Reg0()
+		p := s.Prog(ppc64.AMOVW)
+		p.From.Type = obj.TYPE_CONST
+		p.From.Offset = 0
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = out
+		s.Prog(ppc64.ASYNC)
+		p0 := s.Prog(ppc64.ALWAR)
+		p0.From.Type = obj.TYPE_MEM
+		p0.From.Reg = r0
+		p0.To.Type = obj.TYPE_REG
+		p0.To.Reg = ppc64.REGTMP
+		p1 := s.Prog(ppc64.ACMPW)
+		p1.From.Type = obj.TYPE_REG
+		p1.From.Reg = r1
+		p1.To.Reg = ppc64.REGTMP
+		p1.To.Type = obj.TYPE_REG
+		p2 := s.Prog(ppc64.ABNE)
+		p2.To.Type = obj.TYPE_BRANCH
+		p3 := s.Prog(ppc64.ASTWCCC)
+		p3.From.Type = obj.TYPE_REG
+		p3.From.Reg = r2
+		p3.To.Type = obj.TYPE_MEM
+		p3.To.Reg = r0
+		p4 := s.Prog(ppc64.ABNE)
+		p4.To.Type = obj.TYPE_BRANCH
+		p4.To.SetTarget(p0)
+		p5 := s.Prog(ppc64.AMOVW)
+		p5.From.Type = obj.TYPE_CONST
+		p5.From.Offset = 1
+		p5.To.Type = obj.TYPE_REG
+		p5.To.Reg = out
+		pisync := s.Prog(ppc64.AISYNC)
+		p2.To.SetTarget(pisync)
+
+	case ssaop.OpPPCLoweredPubBarrier:
+		// SYNC
+		s.Prog(v.Op.Asm())
+
+	case ssaop.OpPPCLoweredGetClosurePtr:
+		// Closure pointer is R11 (already)
+		ssagen.CheckLoweredGetClosurePtr(v)
+
+	case ssaop.OpPPCLoweredGetCallerSP:
+		// caller's SP is FixedFrameSize below the address of the first arg
+		p := s.Prog(ppc64.AMOVW)
+		p.From.Type = obj.TYPE_ADDR
+		p.From.Offset = -base.Ctxt.Arch.FixedFrameSize
+		p.From.Name = obj.NAME_PARAM
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+	case ssaop.OpPPCLoweredGetCallerPC:
+		p := s.Prog(obj.AGETCALLERPC)
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+	case ssaop.OpLoadReg:
+		loadOp := loadByType(v.Type)
+		p := s.Prog(loadOp)
+		ssagen.AddrAuto(&p.From, v.Args[0])
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+	case ssaop.OpStoreReg:
+		storeOp := storeByType(v.Type)
+		p := s.Prog(storeOp)
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = v.Args[0].Reg()
+		ssagen.AddrAuto(&p.To, v)
+
+	case ssaop.OpPPCDIVW:
+		// For now,
+		//
+		// cmp arg1, -1
+		// be  ahead
+		// v = arg0 / arg1
+		// b over
+		// ahead: v = - arg0
+		// over: nop
+		r := v.Reg()
+		r0 := v.Args[0].Reg()
+		r1 := v.Args[1].Reg()
+
+		p := s.Prog(ppc64.ACMPW)
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = r1
+		p.To.Type = obj.TYPE_CONST
+		p.To.Offset = -1
+
+		pbahead := s.Prog(ppc64.ABEQ)
+		pbahead.To.Type = obj.TYPE_BRANCH
+
+		p = s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = r1
+		p.Reg = r0
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = r
+
+		pbover := s.Prog(obj.AJMP)
+		pbover.To.Type = obj.TYPE_BRANCH
+
+		p = s.Prog(ppc64.ANEG)
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = r
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = r0
+		pbahead.To.SetTarget(p)
+
+		p = s.Prog(obj.ANOP)
+		pbover.To.SetTarget(p)
+
+	case ssaop.OpPPCCLRLSLWI:
+		r := v.Reg()
+		r1 := v.Args[0].Reg()
+		shifts := v.AuxInt
+		p := s.Prog(v.Op.Asm())
+		// clrlslwi ra,rs,mb,sh will become rlwinm ra,rs,sh,mb-sh,31-sh as described in ISA
+		p.From = obj.Addr{Type: obj.TYPE_CONST, Offset: ssa.GetPPC64Shiftmb(shifts)}
+		p.AddRestSourceConst(ssa.GetPPC64Shiftsh(shifts))
+		p.Reg = r1
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = r
+
+	case ssaop.OpPPCADD, ssaop.OpPPCFADD, ssaop.OpPPCFADDS, ssaop.OpPPCSUB, ssaop.OpPPCFSUB, ssaop.OpPPCFSUBS,
+		ssaop.OpPPCMULLW, ssaop.OpPPCDIVWU,
+		ssaop.OpPPCSRAW, ssaop.OpPPCSRW, ssaop.OpPPCSLW,
+		ssaop.OpPPCROTLW,
+		ssaop.OpPPCMULHW, ssaop.OpPPCMULHWU,
+		ssaop.OpPPCFMUL, ssaop.OpPPCFMULS, ssaop.OpPPCFDIV, ssaop.OpPPCFDIVS,
+		ssaop.OpPPCAND, ssaop.OpPPCOR, ssaop.OpPPCANDN, ssaop.OpPPCORN, ssaop.OpPPCNOR, ssaop.OpPPCXOR, ssaop.OpPPCEQV:
+		r := v.Reg()
+		r1 := v.Args[0].Reg()
+		r2 := v.Args[1].Reg()
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = r2
+		p.Reg = r1
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = r
+
+	case ssaop.OpPPCROTLWconst:
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_CONST
+		p.From.Offset = v.AuxInt
+		p.Reg = v.Args[0].Reg()
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+		// Auxint holds encoded rotate + mask
+	case ssaop.OpPPCRLWINM, ssaop.OpPPCRLWMI:
+		sh, mb, me, _ := ssa.DecodePPC64RotateMask(v.AuxInt)
+		p := s.Prog(v.Op.Asm())
+		p.To = obj.Addr{Type: obj.TYPE_REG, Reg: v.Reg()}
+		p.Reg = v.Args[0].Reg()
+		p.From = obj.Addr{Type: obj.TYPE_CONST, Offset: sh}
+		p.AddRestSourceArgs([]obj.Addr{{Type: obj.TYPE_CONST, Offset: mb}, {Type: obj.TYPE_CONST, Offset: me}})
+
+	case ssaop.OpPPCRLWNM:
+		_, mb, me, _ := ssa.DecodePPC64RotateMask(v.AuxInt)
+		p := s.Prog(v.Op.Asm())
+		p.To = obj.Addr{Type: obj.TYPE_REG, Reg: v.Reg()}
+		p.Reg = v.Args[0].Reg()
+		p.From = obj.Addr{Type: obj.TYPE_REG, Reg: v.Args[1].Reg()}
+		p.AddRestSourceArgs([]obj.Addr{{Type: obj.TYPE_CONST, Offset: mb}, {Type: obj.TYPE_CONST, Offset: me}})
+
+	case ssaop.OpPPCNEG, ssaop.OpPPCFNEG, ssaop.OpPPCFCTIWZ, ssaop.OpPPCFRSP, ssaop.OpPPCCNTLZW,
+		ssaop.OpPPCFABS, ssaop.OpPPCFNABS:
+		r := v.Reg()
+		p := s.Prog(v.Op.Asm())
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = r
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = v.Args[0].Reg()
+
+	case ssaop.OpPPCADDconst, ssaop.OpPPCORconst, ssaop.OpPPCXORconst,
+		ssaop.OpPPCSRAWconst, ssaop.OpPPCSRWconst, ssaop.OpPPCSLWconst,
+		ssaop.OpPPCMULLWconst, ssaop.OpPPCANDconst:
+		p := s.Prog(v.Op.Asm())
+		p.Reg = v.Args[0].Reg()
+		p.From.Type = obj.TYPE_CONST
+		p.From.Offset = v.AuxInt
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+	case ssaop.OpPPCADDC, ssaop.OpPPCSUBC, ssaop.OpPPCADDEcarry:
+		// Tuple ops: the carry is the second, register-less result.
+		r := v.Reg0()
+		r1 := v.Args[0].Reg()
+		r2 := v.Args[1].Reg()
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = r2
+		p.Reg = r1
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = r
+
+	case ssaop.OpPPCADDE, ssaop.OpPPCSUBE:
+		// The carry input (arg2) is implicit.
+		r := v.Reg()
+		r1 := v.Args[0].Reg()
+		r2 := v.Args[1].Reg()
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = r2
+		p.Reg = r1
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = r
+
+	case ssaop.OpPPCMaskIfNotCarry:
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = ppc64.REG_R0
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+	case ssaop.OpPPCADDCconst:
+		p := s.Prog(v.Op.Asm())
+		p.Reg = v.Args[0].Reg()
+		p.From.Type = obj.TYPE_CONST
+		p.From.Offset = v.AuxInt
+		p.To.Type = obj.TYPE_REG
+		// Output is a pair, the second is the CA, which is implied.
+		p.To.Reg = v.Reg0()
+
+	case ssaop.OpPPCADDconstForCarry:
+		// ADDC $c, Rx, REGTMP; only the carry matters.
+		p := s.Prog(v.Op.Asm())
+		p.Reg = v.Args[0].Reg()
+		p.From.Type = obj.TYPE_CONST
+		p.From.Offset = v.AuxInt
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = ppc64.REGTMP
+
+	case ssaop.OpPPCSUBFCconst:
+		p := s.Prog(v.Op.Asm())
+		p.AddRestSourceConst(v.AuxInt)
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = v.Args[0].Reg()
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+	case ssaop.OpPPCMOVWaddr:
+		switch v.Aux.(type) {
+		default:
+			v.Fatalf("aux in MOVWaddr is of unknown type %T", v.Aux)
+		case nil:
+			// If aux offset and aux int are both 0, and the same
+			// input and output regs are used, no instruction
+			// needs to be generated, since it would just be
+			// addi rx, rx, 0.
+			if v.AuxInt != 0 || v.Args[0].Reg() != v.Reg() {
+				p := s.Prog(ppc64.AMOVW)
+				p.From.Type = obj.TYPE_ADDR
+				p.From.Reg = v.Args[0].Reg()
+				p.From.Offset = v.AuxInt
+				p.To.Type = obj.TYPE_REG
+				p.To.Reg = v.Reg()
+			}
+
+		case *obj.LSym, ir.Node:
+			p := s.Prog(ppc64.AMOVW)
+			p.From.Type = obj.TYPE_ADDR
+			p.From.Reg = v.Args[0].Reg()
+			p.To.Type = obj.TYPE_REG
+			p.To.Reg = v.Reg()
+			ssagen.AddAux(&p.From, v)
+
+		}
+
+	case ssaop.OpPPCMOVWconst:
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_CONST
+		p.From.Offset = v.AuxInt
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+	case ssaop.OpPPCFMOVDconst, ssaop.OpPPCFMOVSconst:
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_FCONST
+		p.From.Val = math.Float64frombits(uint64(v.AuxInt))
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
+	case ssaop.OpPPCFCMPU, ssaop.OpPPCCMPW, ssaop.OpPPCCMPWU:
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = v.Args[0].Reg()
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Args[1].Reg()
+
+	case ssaop.OpPPCCMPWconst, ssaop.OpPPCCMPWUconst:
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = v.Args[0].Reg()
+		p.To.Type = obj.TYPE_CONST
+		p.To.Offset = v.AuxInt
+
+	case ssaop.OpPPCMOVBreg, ssaop.OpPPCMOVBZreg, ssaop.OpPPCMOVHreg, ssaop.OpPPCMOVHZreg:
+		// Shift in register to required size
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_REG
+		p.From.Reg = v.Args[0].Reg()
+		p.To.Reg = v.Reg()
+		p.To.Type = obj.TYPE_REG
+
+	case ssaop.OpPPCMOVWload, ssaop.OpPPCMOVHload, ssaop.OpPPCMOVBZload, ssaop.OpPPCMOVHZload, ssaop.OpPPCFMOVDload, ssaop.OpPPCFMOVSload:
+		p := s.Prog(v.Op.Asm())
+		p.From.Type = obj.TYPE_MEM
+		p.From.Reg = v.Args[0].Reg()
+		ssagen.AddAux(&p.From, v)
+		p.To.Type = obj.TYPE_REG
+		p.To.Reg = v.Reg()
+
