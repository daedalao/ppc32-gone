+(MOVBstoreidx ptr idx (MOV(B|BZ|H|HZ)reg x) mem) => (MOVBstoreidx ptr idx x mem)
+(MOVHstoreidx ptr idx (MOV(H|HZ)reg x) mem) => (MOVHstoreidx ptr idx x mem)
+
+(CMPW x (MOVWconst [c])) && ssa.Is16Bit(int64(c)) => (CMPWconst x [c])
+(CMPW (MOVWconst [c]) y) && ssa.Is16Bit(int64(c)) => (InvertFlags (CMPWconst y [c]))
+(CMPWU x (MOVWconst [c])) && isU16Bit(int64(c)) => (CMPWUconst x [c])
+(CMPWU (MOVWconst [c]) y) && isU16Bit(int64(c)) => (InvertFlags (CMPWUconst y [c]))
