+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build linux && ppc
+
+#include "go_asm.h"
+#include "textflag.h"
+
+TEXT _rt0_ppc_linux(SB),NOSPLIT,$0
+	XOR	R0, R0	// Make sure R0 is zero before _main
+	BR	_main<>(SB)
+
+TEXT _rt0_ppc_linux_lib(SB),NOSPLIT|NOFRAME,$0
+	// -buildmode=c-shared and c-archive are not supported yet.
+	UNDEF
+
+TEXT _main<>(SB),NOSPLIT|NOFRAME,$0
+	// On 32-bit PowerPC the initial stack pointer points at argc,
+	// followed by argv, envv and auxv, both for statically linked
+	// binaries (kernel entry) and for dynamically linked ones
+	// (the glibc loader restores the initial stack before jumping
+	// to the entry point).
+	MOVW	0(R1), R3	// argc
+	ADD	$4, R1, R4	// argv
+	BR	main(SB)
+
+TEXT main(SB),NOSPLIT|NOFRAME,$0
+	MOVW	$runtime·rt0_go(SB), R12
+	MOVW	R12, CTR
+	BR	(CTR)
