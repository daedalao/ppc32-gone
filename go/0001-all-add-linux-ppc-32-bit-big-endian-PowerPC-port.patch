+	MOVW	mp+8(FP), R8
+	MOVW	gp+12(FP), R9
+	MOVW	fn+16(FP), R12
+
+	MOVW	R8, -4(R4)
+	MOVW	R9, -8(R4)
+	MOVW	R12, -12(R4)
+	MOVW	$1234, R8
+	MOVW	R8, -16(R4)
+
+	SYSCALL $SYS_clone
+	BVC	2(PC)
+	NEG	R3	// caller expects negative errno
+
+	// In parent, return.
+	CMPW	R3, $0
+	BEQ	3(PC)
+	MOVW	R3, ret+20(FP)
+	RET
+
+	// In child, on new stack.
+	XOR	R0, R0
+	MOVW	-16(R1), R8
+	CMPW	R8, $1234
+	BEQ	2(PC)
+	MOVW	R0, 0(R0)
+
+	// Initialize m->procid to Linux tid
+	SYSCALL $SYS_gettid
+
+	MOVW	-12(R1), R12       // fn
+	MOVW	-8(R1), R9         // g
+	MOVW	-4(R1), R8         // m
+
+	CMPW	R8, $0
+	BEQ	nog
+	CMPW	R9, $0
+	BEQ	nog
+
+	MOVW	R3, m_procid(R8)
+
+	// In child, set up new stack
+	MOVW	R8, g_m(R9)
+	MOVW	R9, g
+	//CALL	runtime·stackcheck(SB)
+
+nog:
+	// Call fn
+	MOVW	R12, CTR
+	BL	(CTR)
+
+	// It shouldn't return.	 If it does, exit that thread.
+	MOVW	$111, R3
+	SYSCALL	$SYS_exit
+	BR	-2(PC)	// keep exiting
+
+TEXT runtime·sigaltstack(SB),NOSPLIT|NOFRAME,$0-8
+	MOVW	new+0(FP), R3
+	MOVW	old+4(FP), R4
+	SYSCALL	$SYS_sigaltstack
+	BVC	2(PC)
+	MOVW	R0, 0xf0(R0)  // crash
+	RET
+
+TEXT runtime·osyield(SB),NOSPLIT|NOFRAME,$0
+	SYSCALL	$SYS_sched_yield
+	RET
+
+TEXT runtime·sched_getaffinity(SB),NOSPLIT|NOFRAME,$0-16
+	MOVW	pid+0(FP), R3
+	MOVW	len+4(FP), R4
+	MOVW	buf+8(FP), R5
+	SYSCALL	$SYS_sched_getaffinity
+	BVC	2(PC)
+	NEG	R3	// caller expects negative errno
+	MOVW	R3, ret+12(FP)
+	RET
+
+// func sbrk0() uintptr
+TEXT runtime·sbrk0(SB),NOSPLIT|NOFRAME,$0-4
+	// Implemented as brk(NULL).
+	MOVW	$0, R3
+	SYSCALL	$SYS_brk
+	MOVW	R3, ret+0(FP)
+	RET
+
+TEXT runtime·access(SB),$0-12
+	MOVW	R0, 0(R0) // unimplemented, only needed for android; declared in stubs_linux.go
+	MOVW	R0, ret+8(FP) // for vet
+	RET
+
+TEXT runtime·connect(SB),$0-16
+	MOVW	R0, 0(R0) // unimplemented, only needed for android; declared in stubs_linux.go
+	MOVW	R0, ret+12(FP) // for vet
+	RET
+
+TEXT runtime·socket(SB),$0-16
+	MOVW	R0, 0(R0) // unimplemented, only needed for android; declared in stubs_linux.go
+	MOVW	R0, ret+12(FP) // for vet
+	RET
