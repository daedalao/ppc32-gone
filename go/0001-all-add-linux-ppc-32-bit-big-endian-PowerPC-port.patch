--- /dev/null
+++ b/src/internal/runtime/atomic/atomic_ppc.s
@@ -0,0 +1,344 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build ppc
+
+#include "textflag.h"
+
+// 32-bit PowerPC atomics. Only sync (not lwsync) is used for the
+// release barrier since lwsync is not implemented on all 32-bit cores.
+
+// bool cas(uint32 *ptr, uint32 old, uint32 new)
+// Atomically:
+//	if(*val == old){
+//		*val = new;
+//		return 1;
+//	} else
+//		return 0;
+TEXT ·Cas(SB), NOSPLIT, $0-13
+	MOVW	ptr+0(FP), R3
+	MOVW	old+4(FP), R4
+	MOVW	new+8(FP), R5
+	SYNC
+cas_again:
+	LWAR	(R3), R6
+	CMPW	R6, R4
+	BNE	cas_fail
+	STWCCC	R5, (R3)
+	BNE	cas_again
+	MOVW	$1, R3
+	ISYNC
+	MOVB	R3, ret+12(FP)
+	RET
+cas_fail:
+	ISYNC
+	MOVB	R0, ret+12(FP)
+	RET
+
+TEXT ·CasRel(SB), NOSPLIT, $0-13
+	MOVW	ptr+0(FP), R3
+	MOVW	old+4(FP), R4
+	MOVW	new+8(FP), R5
+	SYNC
+cas_again:
+	LWAR	(R3), R6
+	CMPW	R6, R4
+	BNE	cas_fail
+	STWCCC	R5, (R3)
+	BNE	cas_again
+	MOVW	$1, R3
+	MOVB	R3, ret+12(FP)
+	RET
+cas_fail:
+	MOVB	R0, ret+12(FP)
+	RET
+
+TEXT ·Casint32(SB), NOSPLIT, $0-13
+	BR	·Cas(SB)
+
+TEXT ·Casint64(SB), NOSPLIT, $0-21
+	BR	·Cas64(SB)
+
+TEXT ·Casuintptr(SB), NOSPLIT, $0-13
+	BR	·Cas(SB)
+
+TEXT ·Casp1(SB), NOSPLIT, $0-13
+	BR	·Cas(SB)
+
+TEXT ·Loaduintptr(SB), NOSPLIT|NOFRAME, $0-8
+	BR	·Load(SB)
+
+TEXT ·LoadAcquintptr(SB), NOSPLIT|NOFRAME, $0-8
+	BR	·LoadAcq(SB)
+
+TEXT ·Loaduint(SB), NOSPLIT|NOFRAME, $0-8
+	BR	·Load(SB)
+
+TEXT ·Loadint32(SB), NOSPLIT, $0-8
+	BR	·Load(SB)
+
+TEXT ·Loadint64(SB), NOSPLIT, $0-12
+	BR	·Load64(SB)
+
+TEXT ·Storeint32(SB), NOSPLIT, $0-8
+	BR	·Store(SB)
+
+TEXT ·Storeint64(SB), NOSPLIT, $0-12
+	BR	·Store64(SB)
+
+TEXT ·Storeuintptr(SB), NOSPLIT, $0-8
+	BR	·Store(SB)
+
+TEXT ·StoreReluintptr(SB), NOSPLIT, $0-8
+	BR	·StoreRel(SB)
+
+TEXT ·Xadduintptr(SB), NOSPLIT, $0-12
+	BR	·Xadd(SB)
+
+TEXT ·Xaddint32(SB), NOSPLIT, $0-12
+	BR	·Xadd(SB)
+
+TEXT ·Xaddint64(SB), NOSPLIT, $0-20
+	BR	·Xadd64(SB)
+
+TEXT ·Xchgint32(SB), NOSPLIT, $0-12
+	BR	·Xchg(SB)
+
+TEXT ·Xchgint64(SB), NOSPLIT, $0-20
+	BR	·Xchg64(SB)
+
+TEXT ·Xchguintptr(SB), NOSPLIT, $0-12
+	BR	·Xchg(SB)
+
+TEXT ·StorepNoWB(SB), NOSPLIT, $0-8
+	BR	·Store(SB)
+
+TEXT ·Load(SB),NOSPLIT|NOFRAME,$0-8
+	MOVW	ptr+0(FP), R3
+	SYNC
+	MOVW	0(R3), R3
+	CMPW	R3, R3, CR7
+	BC	4, 30, 1(PC) // bne- cr7,0x4
+	ISYNC
+	MOVW	R3, ret+4(FP)
+	RET
+
+TEXT ·Load8(SB),NOSPLIT|NOFRAME,$0-5
+	MOVW	ptr+0(FP), R3
+	SYNC
+	MOVBZ	0(R3), R3
+	CMPW	R3, R3, CR7
+	BC	4, 30, 1(PC) // bne- cr7,0x4
+	ISYNC
+	MOVB	R3, ret+4(FP)
+	RET
+
+TEXT ·Loadp(SB),NOSPLIT|NOFRAME,$0-8
+	MOVW	ptr+0(FP), R3
+	SYNC
+	MOVW	0(R3), R3
+	CMPW	R3, R3, CR7
+	BC	4, 30, 1(PC) // bne- cr7,0x4
+	ISYNC
+	MOVW	R3, ret+4(FP)
+	RET
+
+TEXT ·LoadAcq(SB),NOSPLIT|NOFRAME,$0-8
+	MOVW	ptr+0(FP), R3
+	MOVW	0(R3), R3
+	CMPW	R3, R3, CR7
+	BC	4, 30, 1(PC) // bne- cr7, 0x4
+	ISYNC
+	MOVW	R3, ret+4(FP)
+	RET
+
+TEXT ·Xadd(SB), NOSPLIT, $0-12
+	MOVW	ptr+0(FP), R4
+	MOVW	delta+4(FP), R5
+	SYNC
+	LWAR	(R4), R3
+	ADD	R5, R3
+	STWCCC	R3, (R4)
+	BNE	-3(PC)
+	ISYNC
+	MOVW	R3, ret+8(FP)
+	RET
+
+TEXT ·Xchg8(SB), NOSPLIT, $0-9
+	MOVW	ptr+0(FP), R4
+	MOVBZ	new+4(FP), R5
+	// Big endian: the byte lives in the word at ptr&^3, at bit
+	// position 8*(3-(ptr&3)) from the least significant end.
+	ANDCC	$3, R4, R6
+	XOR	$3, R6		// 3 - (ptr & 3)
+	SLW	$3, R6		// * 8 = shift amount
+	MOVW	$0xFF, R7
+	SLW	R6, R7		// byte mask
+	SLW	R6, R5		// new value in position
+	RLWNM	$0, R4, $0xfffffffc, R4	// word address
+	SYNC
+again:
+	LWAR	(R4), R3
+	ANDN	R7, R3, R8	// clear the byte
+	OR	R5, R8		// insert new byte
+	STWCCC	R8, (R4)
+	BNE	again
+	ISYNC
+	SRW	R6, R3		// old byte
+	MOVB	R3, ret+8(FP)
+	RET
+
+TEXT ·Xchg(SB), NOSPLIT, $0-12
+	MOVW	ptr+0(FP), R4
+	MOVW	new+4(FP), R5
+	SYNC
+	LWAR	(R4), R3
+	STWCCC	R5, (R4)
+	BNE	-2(PC)
+	ISYNC
+	MOVW	R3, ret+8(FP)
+	RET
+
+TEXT ·Store(SB), NOSPLIT, $0-8
+	MOVW	ptr+0(FP), R3
+	MOVW	val+4(FP), R4
+	SYNC
+	MOVW	R4, 0(R3)
+	RET
+
+TEXT ·Store8(SB), NOSPLIT, $0-5
+	MOVW	ptr+0(FP), R3
+	MOVB	val+4(FP), R4
+	SYNC
+	MOVB	R4, 0(R3)
+	RET
+
+TEXT ·StoreRel(SB), NOSPLIT, $0-8
+	MOVW	ptr+0(FP), R3
+	MOVW	val+4(FP), R4
+	SYNC
+	MOVW	R4, 0(R3)
+	RET
+
+// void ·Or8(byte volatile*, byte);
+TEXT ·Or8(SB), NOSPLIT, $0-5
+	MOVW	ptr+0(FP), R3
+	MOVBZ	val+4(FP), R4
+	ANDCC	$3, R3, R6
+	XOR	$3, R6		// big endian byte position
+	SLW	$3, R6
+	SLW	R6, R4		// value in position
+	RLWNM	$0, R3, $0xfffffffc, R3	// word address
+	SYNC
+again:
+	LWAR	(R3), R7
+	OR	R4, R7
+	STWCCC	R7, (R3)
+	BNE	again
+	ISYNC
+	RET
+
+// void ·And8(byte volatile*, byte);
+TEXT ·And8(SB), NOSPLIT, $0-5
+	MOVW	ptr+0(FP), R3
+	MOVBZ	val+4(FP), R4
+	ANDCC	$3, R3, R6
+	XOR	$3, R6		// big endian byte position
+	SLW	$3, R6
+	MOVW	$0xFF, R7
+	SLW	R6, R7		// byte mask
+	SLW	R6, R4		// value in position
+	ANDN	R7, R4, R8	// R8 = R4 &^ R7 ... wait we need (val<<sh) | ^mask
+	NOR	R7, R7, R7	// ^mask
+	OR	R7, R4		// (val << sh) | ^mask
+	RLWNM	$0, R3, $0xfffffffc, R3	// word address
+	SYNC
+again:
+	LWAR	(R3), R7
+	AND	R4, R7
+	STWCCC	R7, (R3)
+	BNE	again
+	ISYNC
+	RET
+
+// func Or(addr *uint32, v uint32)
+TEXT ·Or(SB), NOSPLIT, $0-8
+	MOVW	ptr+0(FP), R3
+	MOVW	val+4(FP), R4
+	SYNC
+again:
+	LWAR	(R3), R6
+	OR	R4, R6
+	STWCCC	R6, (R3)
+	BNE	again
+	ISYNC
+	RET
+
+// func And(addr *uint32, v uint32)
+TEXT ·And(SB), NOSPLIT, $0-8
+	MOVW	ptr+0(FP), R3
+	MOVW	val+4(FP), R4
+	SYNC
+again:
+	LWAR	(R3),R6
+	AND	R4, R6
+	STWCCC	R6, (R3)
+	BNE	again
+	ISYNC
+	RET
+
+// func Or32(addr *uint32, v uint32) old uint32
+TEXT ·Or32(SB), NOSPLIT, $0-12
+	MOVW	ptr+0(FP), R3
+	MOVW	val+4(FP), R4
+	SYNC
+again:
+	LWAR	(R3), R6
+	OR	R4, R6, R7
+	STWCCC	R7, (R3)
+	BNE	again
+	ISYNC
+	MOVW	R6, ret+8(FP)
+	RET
+
+// func And32(addr *uint32, v uint32) old uint32
+TEXT ·And32(SB), NOSPLIT, $0-12
+	MOVW	ptr+0(FP), R3
+	MOVW	val+4(FP), R4
+	SYNC
+again:
+	LWAR	(R3),R6
+	AND	R4, R6, R7
+	STWCCC	R7, (R3)
+	BNE	again
+	ISYNC
+	MOVW	R6, ret+8(FP)
+	RET
+
+TEXT ·Anduintptr(SB), NOSPLIT, $0-12
+	BR	·And32(SB)
+
+TEXT ·Oruintptr(SB), NOSPLIT, $0-12
+	BR	·Or32(SB)
+
+// void spinLock(state *uint32)
+TEXT ·spinLock(SB),NOSPLIT,$0-4
+	MOVW	state+0(FP), R3
+	MOVW	$1, R4
+	SYNC
+try_lock:
+	LWAR	(R3), R5
+	CMPW	R5, $0
+	BNE	try_lock
+	STWCCC	R4, (R3)
+	BNE	try_lock
+	ISYNC
+	RET
+
+// void spinUnlock(state *uint32)
+TEXT ·spinUnlock(SB),NOSPLIT,$0-4
+	MOVW	state+0(FP), R3
+	SYNC
+	MOVW	R0, (R3)
+	RET
