+	SYSCALL	R9
+	BVC	ok
+	MOVW	$-1, R4
+	MOVW	R4, r1+16(FP)	// r1
+	MOVW	R3, err+20(FP)	// errno
+	RET
+ok:
+	MOVW	R3, r1+16(FP)	// r1
+	MOVW	R0, err+20(FP)	// errno
+	RET
+
+// func rawSyscallNoError(trap, a1, a2, a3 uintptr) (r1, r2 uintptr)
+TEXT ·rawSyscallNoError(SB),NOSPLIT|NOFRAME,$0-24
+	MOVW	a1+4(FP), R3
+	MOVW	a2+8(FP), R4
+	MOVW	a3+12(FP), R5
+	MOVW	R0, R6
+	MOVW	R0, R7
