+// func nanotime1() int64
+TEXT runtime·nanotime1(SB),NOSPLIT,$16-8
+	MOVW	$1, R3		// CLOCK_MONOTONIC
+	ADD	$FIXED_FRAME, R1, R4
+	SYSCALL	$SYS_clock_gettime64
+	BVC	ok64
+	MOVW	$1, R3
+	ADD	$FIXED_FRAME, R1, R4
+	SYSCALL	$SYS_clock_gettime
+	MOVW	FIXED_FRAME+0(R1), R6	// sec (int32)
+	MOVW	FIXED_FRAME+4(R1), R7	// nsec
+	SRAW	$31, R6, R5		// sec hi
+	BR	compute
+ok64:
+	MOVW	FIXED_FRAME+0(R1), R5	// sec hi
+	MOVW	FIXED_FRAME+4(R1), R6	// sec lo
+	MOVW	FIXED_FRAME+12(R1), R7	// nsec
+compute:
+	// return sec*1e9 + nsec as int64 in R9:R10
+	MOVW	$1000000000, R8
+	MULHWU	R6, R8, R9	// high word of seclo*1e9
+	MULLW	R6, R8, R10	// low word of seclo*1e9
+	MULLW	R5, R8, R11	// sechi*1e9 (low word)
+	ADD	R11, R9
+	ADDC	R7, R10		// lo += nsec
+	ADDZE	R9, R9		// hi += carry
+	MOVW	R9, ret+0(FP)
+	MOVW	R10, ret+4(FP)
+	RET
