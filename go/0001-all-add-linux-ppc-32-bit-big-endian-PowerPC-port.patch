+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build ppc
+
+#include "textflag.h"
+#include "funcdata.h"
+
+#define FIXED_FRAME 8
+
+// makeFuncStub is the code half of the function returned by MakeFunc.
+// See the comment on the declaration of makeFuncStub in makefunc.go
+// for more details.
+// No arg size here, runtime pulls arg map out of the func value.
+TEXT ·makeFuncStub(SB),(NOSPLIT|WRAPPER),$20
+	NO_LOCAL_POINTERS
+	MOVW	R11, FIXED_FRAME+0(R1)
+	MOVW	$argframe+0(FP), R3
+	MOVW	R3, FIXED_FRAME+4(R1)
+	MOVB	R0, FIXED_FRAME+16(R1)
+	ADD	$FIXED_FRAME+16, R1, R3
+	MOVW	R3, FIXED_FRAME+8(R1)
+	MOVW	R0, FIXED_FRAME+12(R1)
+	BL	·callReflect(SB)
+	RET
+
+// methodValueCall is the code half of the function returned by makeMethodValue.
+// See the comment on the declaration of methodValueCall in makefunc.go
+// for more details.
+// No arg size here; runtime pulls arg map out of the func value.
+TEXT ·methodValueCall(SB),(NOSPLIT|WRAPPER),$20
+	NO_LOCAL_POINTERS
+	MOVW	R11, FIXED_FRAME+0(R1)
+	MOVW	$argframe+0(FP), R3
+	MOVW	R3, FIXED_FRAME+4(R1)
+	MOVB	R0, FIXED_FRAME+16(R1)
+	ADD	$FIXED_FRAME+16, R1, R3
+	MOVW	R3, FIXED_FRAME+8(R1)
+	MOVW	R0, FIXED_FRAME+12(R1)
+	BL	·callMethod(SB)
+	RET
diff --git a/src/runtime/asm_ppc.s b/src/runtime/asm_ppc.s
new file mode 100644
index 0000000000..a74d2b605f
--- /dev/null
+++ b/src/runtime/asm_ppc.s
@@ -0,0 +1,937 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build ppc
+
+#include "go_asm.h"
+#include "go_tls.h"
+#include "funcdata.h"
+#include "textflag.h"
+
+// FIXED_FRAME is the size of the fixed part of a Go frame on
+// 32-bit ppc: 0(R1) holds the saved LR, 4(R1) is the SysV LR save
+// slot used by C callees.
+#define FIXED_FRAME 8
+
+TEXT runtime·rt0_go(SB),NOSPLIT|TOPFRAME,$0
+	// R1 = stack; R3 = argc; R4 = argv
+
+	XOR	R0, R0	// R0 is always zero
+	SUB	$(FIXED_FRAME+8), R1
+	MOVW	R3, FIXED_FRAME+0(R1)	// argc
+	MOVW	R4, FIXED_FRAME+4(R1)	// argv
+
+	// create istack out of the given (operating system) stack.
+	// _cgo_init may update stackguard.
+	MOVW	$runtime·g0(SB), g
+	BL	runtime·save_g(SB)
+	MOVW	$(-64*1024), R31
+	ADD	R31, R1, R3
+	MOVW	R3, g_stackguard0(g)
+	MOVW	R3, g_stackguard1(g)
