index 0000000000..3b72d9a010
--- /dev/null
+++ b/src/internal/bytealg/equal_ppc.s
@@ -0,0 +1,66 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build ppc
+
+#include "go_asm.h"
+#include "textflag.h"
+
+// memequal(a, b unsafe.Pointer, size uintptr) bool
+TEXT runtime·memequal(SB),NOSPLIT,$0-13
+	MOVW	a+0(FP), R3
+	MOVW	b+4(FP), R4
+	MOVW	size+8(FP), R5
+	BL	memeqbody<>(SB)
+	MOVB	R3, ret+12(FP)
+	RET
+
+// memequal_varlen(a, b unsafe.Pointer) bool
+TEXT runtime·memequal_varlen(SB),NOSPLIT,$0-9
+	MOVW	a+0(FP), R3
+	MOVW	b+4(FP), R4
+	MOVW	4(R11), R5	// compiler stores size at offset 4 in the closure
+	BL	memeqbody<>(SB)
+	MOVB	R3, ret+8(FP)
+	RET
+
+// memeqbody compares R5 bytes at R3 and R4 and returns the result in R3.
+// It does not use the stack; LR is preserved by the callers (which are
+// NOFRAME) only because memeqbody is a leaf that does not touch it.
+// Unaligned word loads are fine on 32-bit PowerPC.
+TEXT memeqbody<>(SB),NOSPLIT|NOFRAME,$0-0
+	CMPW	R3, R4
+	BEQ	eq
+	SRW	$2, R5, R6	// number of words
+	CMPW	R6, $0
+	BEQ	tail
+	MOVW	R6, CTR
+	SUB	$4, R3
+	SUB	$4, R4
+words:
+	MOVWU	4(R3), R7
+	MOVWU	4(R4), R8
+	CMPW	R7, R8
+	BNE	ne
+	BDNZ	words
+	ADD	$4, R3
+	ADD	$4, R4
+tail:
+	ANDCC	$3, R5, R6	// remaining bytes
+	BEQ	eq
+	MOVW	R6, CTR
+	SUB	$1, R3
+	SUB	$1, R4
+bytes:
+	MOVBZU	1(R3), R7
+	MOVBZU	1(R4), R8
+	CMPW	R7, R8
+	BNE	ne
+	BDNZ	bytes
+eq:
+	MOVW	$1, R3
+	RET
+ne:
+	MOVW	$0, R3
+	RET
