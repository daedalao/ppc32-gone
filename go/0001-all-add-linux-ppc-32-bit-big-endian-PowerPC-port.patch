+	MOVW	from+4(FP), R4
+	MOVW	n+8(FP), R5
+
+	CMPW	R5, $0
+	BEQ	done
+	CMPWU	R3, R4
+	BEQ	done		// to == from
+	BLT	forward		// to < from
+	ADD	R4, R5, R6	// from+n
+	CMPWU	R3, R6
+	BGE	forward		// to >= from+n, no overlap
+
+	// Destination overlaps the tail of the source: copy backward.
+	ADD	R5, R3, R7	// to+n
+	ADD	R5, R4, R8	// from+n
+	SRW	$2, R5, R9	// number of words
+	CMPW	R9, $0
+	BEQ	btail
+	MOVW	R9, CTR
+bwords:
+	MOVWU	-4(R8), R10
+	MOVWU	R10, -4(R7)
+	BDNZ	bwords
+btail:
+	ANDCC	$3, R5, R9
+	BEQ	done
+	MOVW	R9, CTR
+bbytes:
+	MOVBZU	-1(R8), R10
+	MOVBU	R10, -1(R7)
+	BDNZ	bbytes
+	RET
+
+forward:
+	SRW	$2, R5, R9	// number of words
+	CMPW	R9, $0
+	BEQ	ftail
+	MOVW	R9, CTR
+	SUB	$4, R3
+	SUB	$4, R4
+fwords:
+	MOVWU	4(R4), R10
+	MOVWU	R10, 4(R3)
+	BDNZ	fwords
+	ADD	$4, R3
+	ADD	$4, R4
+ftail:
+	ANDCC	$3, R5, R9
+	BEQ	done
+	MOVW	R9, CTR
+	SUB	$1, R3
+	SUB	$1, R4
+fbytes:
+	MOVBZU	1(R4), R10
+	MOVBU	R10, 1(R3)
+	BDNZ	fbytes
+
+done:
+	RET
