+	MOVW	$0, R3
+	ADD	$FIXED_FRAME, R1, R4
+	SYSCALL	$SYS_clock_gettime
+	MOVW	FIXED_FRAME+0(R1), R5	// sec (int32)
+	MOVW	FIXED_FRAME+4(R1), R6	// nsec
+	SRAW	$31, R5, R7		// sign extend sec to int64
+	MOVW	R7, sec+0(FP)
+	MOVW	R5, sec+4(FP)
+	MOVW	R6, nsec+8(FP)
+	RET
+ok64:
+	MOVW	FIXED_FRAME+0(R1), R5	// sec hi
+	MOVW	FIXED_FRAME+4(R1), R6	// sec lo
+	MOVW	FIXED_FRAME+12(R1), R7	// nsec (low word of the 64-bit field)
+	MOVW	R5, sec+0(FP)
+	MOVW	R6, sec+4(FP)
+	MOVW	R7, nsec+8(FP)
+	RET
