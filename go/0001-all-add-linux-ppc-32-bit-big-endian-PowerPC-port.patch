+
+// func rawVforkSyscall(trap, a1, a2, a3 uintptr) (r1, err Errno)
+TEXT ·rawVforkSyscall(SB),NOSPLIT|NOFRAME,$0-24
+	MOVW	a1+4(FP), R3
+	MOVW	a2+8(FP), R4
+	MOVW	a3+12(FP), R5
+	MOVW	R0, R6
+	MOVW	R0, R7
