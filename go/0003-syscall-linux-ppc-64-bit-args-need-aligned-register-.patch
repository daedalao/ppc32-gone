From 86ae78c2cd633dde93bcd51a4903f895a023bd43 Mon Sep 17 00:00:00 2001
From: daedalao <daedalao@hotmail.com>
Date: Tue, 8 Sep 2026 20:48:11 -0700
Subject: [PATCH 03/15] syscall: linux/ppc 64-bit args need aligned register
 pairs

Regenerate zsyscall with mksyscall -b32 -arm so 64-bit arguments are
passed in even/odd register pairs, and route SyncFileRange through
sync_file_range2 like x/sys.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0117Su2urNmg96oYM6vhHi1y
---
 src/syscall/syscall_linux_ppc.go  |  8 +++++++-
 src/syscall/zsyscall_linux_ppc.go | 14 +++++++-------
 2 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/src/syscall/syscall_linux_ppc.go b/src/syscall/syscall_linux_ppc.go
index c09470c5f1..76e995de68 100644
--- a/src/syscall/syscall_linux_ppc.go
+++ b/src/syscall/syscall_linux_ppc.go
@@ -36,7 +36,7 @@ const (
 //sys	Shutdown(fd int, how int) (err error)
 //sys	Splice(rfd int, roff *int64, wfd int, woff *int64, len int, flags int) (n int, err error)
 
-//sys	SyncFileRange(fd int, off int64, n int64, flags int) (err error) = SYS_SYNC_FILE_RANGE2
+//sys	syncFileRange2(fd int, flags int, off int64, n int64) (err error) = SYS_SYNC_FILE_RANGE2
 //sys	Truncate(path string, length int64) (err error) = SYS_TRUNCATE64
 //sys	Ustat(dev int, ubuf *Ustat_t) (err error)
 //sys	accept4(s int, rsa *RawSockaddrAny, addrlen *_Socklen, flags int) (fd int, err error)
@@ -130,3 +130,9 @@ func (msghdr *Msghdr) SetControllen(length int) {
 func (cmsg *Cmsghdr) SetLen(length int) {
 	cmsg.Len = uint32(length)
 }
+
+func SyncFileRange(fd int, off int64, n int64, flags int) error {
+	// The sync_file_range syscall for the 32-bit ppc arch is
+	// sync_file_range2, with a different argument order.
+	return syncFileRange2(fd, flags, off, n)
+}
diff --git a/src/syscall/zsyscall_linux_ppc.go b/src/syscall/zsyscall_linux_ppc.go
index c16bcf1fa0..b7fcad13b5 100644
--- a/src/syscall/zsyscall_linux_ppc.go
+++ b/src/syscall/zsyscall_linux_ppc.go
@@ -1,4 +1,4 @@
-// mksyscall.pl -b32 -tags linux,ppc syscall_linux.go syscall_linux_ppc.go
+// mksyscall.pl -b32 -arm -tags linux,ppc syscall_linux.go syscall_linux_ppc.go
 // Code generated by the command above; DO NOT EDIT.
 
 //go:build linux && ppc
@@ -1122,7 +1122,7 @@ func fstatat(dirfd int, path string, stat *Stat_t, flags int) (err error) {
 // THIS FILE IS GENERATED BY THE COMMAND AT THE TOP; DO NOT EDIT
 
 func Ftruncate(fd int, length int64) (err error) {
-	_, _, e1 := Syscall(SYS_FTRUNCATE64, uintptr(fd), uintptr(length>>32), uintptr(length))
+	_, _, e1 := Syscall6(SYS_FTRUNCATE64, uintptr(fd), 0, uintptr(length>>32), uintptr(length), 0, 0)
 	if e1 != 0 {
 		err = errnoErr(e1)
 	}
@@ -1205,7 +1205,7 @@ func pread(fd int, p []byte, offset int64) (n int, err error) {
 	} else {
 		_p0 = unsafe.Pointer(&_zero)
 	}
-	r0, _, e1 := Syscall6(SYS_PREAD64, uintptr(fd), uintptr(_p0), uintptr(len(p)), uintptr(offset>>32), uintptr(offset), 0)
+	r0, _, e1 := Syscall6(SYS_PREAD64, uintptr(fd), uintptr(_p0), uintptr(len(p)), 0, uintptr(offset>>32), uintptr(offset))
 	n = int(r0)
 	if e1 != 0 {
 		err = errnoErr(e1)
@@ -1222,7 +1222,7 @@ func pwrite(fd int, p []byte, offset int64) (n int, err error) {
 	} else {
 		_p0 = unsafe.Pointer(&_zero)
 	}
-	r0, _, e1 := Syscall6(SYS_PWRITE64, uintptr(fd), uintptr(_p0), uintptr(len(p)), uintptr(offset>>32), uintptr(offset), 0)
+	r0, _, e1 := Syscall6(SYS_PWRITE64, uintptr(fd), uintptr(_p0), uintptr(len(p)), 0, uintptr(offset>>32), uintptr(offset))
 	n = int(r0)
 	if e1 != 0 {
 		err = errnoErr(e1)
@@ -1315,8 +1315,8 @@ func Splice(rfd int, roff *int64, wfd int, woff *int64, len int, flags int) (n i
 
 // THIS FILE IS GENERATED BY THE COMMAND AT THE TOP; DO NOT EDIT
 
-func SyncFileRange(fd int, off int64, n int64, flags int) (err error) {
-	_, _, e1 := Syscall6(SYS_SYNC_FILE_RANGE2, uintptr(fd), uintptr(off>>32), uintptr(off), uintptr(n>>32), uintptr(n), uintptr(flags))
+func syncFileRange2(fd int, flags int, off int64, n int64) (err error) {
+	_, _, e1 := Syscall6(SYS_SYNC_FILE_RANGE2, uintptr(fd), uintptr(flags), uintptr(off>>32), uintptr(off), uintptr(n>>32), uintptr(n))
 	if e1 != 0 {
 		err = errnoErr(e1)
 	}
@@ -1331,7 +1331,7 @@ func Truncate(path string, length int64) (err error) {
 	if err != nil {
 		return
 	}
-	_, _, e1 := Syscall(SYS_TRUNCATE64, uintptr(unsafe.Pointer(_p0)), uintptr(length>>32), uintptr(length))
+	_, _, e1 := Syscall6(SYS_TRUNCATE64, uintptr(unsafe.Pointer(_p0)), 0, uintptr(length>>32), uintptr(length), 0, 0)
 	if e1 != 0 {
 		err = errnoErr(e1)
 	}
